#!/usr/bin/env bash
set -u
PHASE="${1:-unknown}"
ACTION="${2:-unknown}"
ROOT=/var/lib/fedora-gnome-custom/suspend
mkdir -p "$ROOT"
printf 'utc=%s\nphase=%s\naction=%s\n' "$(date -u +%FT%TZ)" "$PHASE" "$ACTION" > "$ROOT/latest-${PHASE}.log"
if [[ "$PHASE" == post ]]; then
  systemctl --no-block start fedora-gnome-custom-resume-health.service >/dev/null 2>&1 || true
fi
exit 0
