# Copiez ce fichier vers config/local.conf (ignoré par Git) pour les valeurs propres à la machine.
# Ne placez jamais de mot de passe dans ce fichier : indiquez uniquement le chemin d'un fichier protégé.
#
# IMPORTANT: la copie de cet exemple n'approuve jamais automatiquement la machine.
# Passez explicitement REAL_MACHINE_APPROVED à "true" uniquement sur Fedora 44 bare-metal,
# après revue de la cible, dry-run, baseline et backup pré-APPLY du même commit.
REAL_MACHINE_APPROVED="false"

# Dépôt Borg NON chiffré (ADR 0014) : chemin sur le disque externe, ou ssh://user@hote/chemin
BACKUP_REPOSITORY="/run/media/$USER/XS1000/Backup-Fedora/borg"

# Optionnel : si le second T705 est monté comme volume DATA.
# DATA_MOUNT="/data"

# Optionnel : personnalisation Bash du host Fedora.
# SHELL_UX_HISTORY_SIZE="50000"
# SHELL_UX_HISTORY_FILE_SIZE="100000"
# SHELL_UX_ENABLE_FZF="true"
# SHELL_UX_ENABLE_ZOXIDE="true"
# SHELL_UX_ENABLE_DIRENV="true"
# SHELL_UX_PROMPT_GIT="true"
