{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mathiasseguincadiche/FEDORA_GNOME_CUSTOM/manifests/validation-gate-proof.schema.json",
  "title": "Fedora native Live USB pre-installation observations",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "gate",
    "verdict",
    "environment",
    "project_commit",
    "module_plan_sha256",
    "source_tree_clean",
    "hardware_certification",
    "hardware_fingerprint_sha256",
    "live_kernel",
    "created_utc",
    "checks"
  ],
  "properties": {
    "schema": {
      "const": 2
    },
    "gate": {
      "const": 2
    },
    "verdict": {
      "const": "PASS"
    },
    "environment": {
      "const": "live-usb"
    },
    "project_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "module_plan_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_tree_clean": {
      "const": true
    },
    "hardware_certification": {
      "const": "PREINSTALL_ONLY"
    },
    "hardware_fingerprint_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "live_kernel": {
      "type": "string",
      "minLength": 1
    },
    "created_utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T.*Z$"
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status",
          "detail"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z_]+$"
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "NOT_TESTED"
            ]
          },
          "detail": {
            "type": "string"
          }
        }
      }
    }
  }
}
