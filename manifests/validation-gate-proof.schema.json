{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mathiasseguincadiche/FEDORA_GNOME_CUSTOM/manifests/validation-gate-proof.schema.json",
  "title": "FEDORA_GNOME_CUSTOM portable validation gate proof",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "gate",
    "verdict",
    "environment",
    "project_commit",
    "module_plan_sha256",
    "environment_effective_config_sha256",
    "environment_fingerprint_sha256",
    "source_tree_clean",
    "hardware_certification",
    "manual_visual",
    "checks",
    "predecessor_sha256",
    "created_utc"
  ],
  "properties": {
    "schema": {"const": 1},
    "gate": {"type": "integer", "enum": [1, 2]},
    "verdict": {"const": "PASS"},
    "environment": {"type": "string", "enum": ["wsl2", "virtualbox"]},
    "project_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "module_plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "environment_effective_config_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "environment_fingerprint_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_tree_clean": {"const": true},
    "hardware_certification": {"const": "DEFERRED"},
    "manual_visual": {"type": "string", "enum": ["N/A", "PASS"]},
    "checks": {"type": "string", "minLength": 1},
    "predecessor_sha256": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      ]
    },
    "created_utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T"}
  }
}
