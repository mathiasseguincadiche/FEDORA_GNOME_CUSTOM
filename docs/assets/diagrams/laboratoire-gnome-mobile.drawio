  <diagram id="laboratoire-gnome-mobile" name="Laboratoire GNOME">
    <mxGraphModel dx="360" dy="1111" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="360" pageHeight="1111" background="#F7F9FC" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="Laboratoire GNOME" style="text;html=1;fontSize=29;fontStyle=1;fontColor=#1A2C43;fontFamily=Arial;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="23" width="280" height="46" as="geometry"/></mxCell>
        <mxCell id="section1" value="RUNNER GITHUB JETABLE" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D9E3EF;fontColor=#2959B4;fontStyle=1;fontSize=17;fontFamily=Arial;verticalAlign=top;align=left;spacingLeft=19;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="10" y="90" width="340" height="992" as="geometry"/></mxCell>
        <mxCell id="t0" value='&lt;b&gt;1. VM Fedora 45&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:17px"&gt;image Cloud finale&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:17px"&gt;signature et SHA-256&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C4D5E8;strokeWidth=1.8;fontColor=#1A2C43;fontSize=20;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="22" y="146" width="316" height="101" as="geometry"/></mxCell>
        <mxCell id="t1" value='&lt;b&gt;2. Dépôt et session&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:17px"&gt;GNOME 51 sous Wayland&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:17px"&gt;natif ou six extensions&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C4D5E8;strokeWidth=1.8;fontColor=#1A2C43;fontSize=20;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="22" y="280" width="316" height="101" as="geometry"/></mxCell>
        <mxCell id="t2" value='&lt;b&gt;3. Données témoin&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:17px"&gt;redémarrage&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:17px"&gt;persistance vérifiée&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C4D5E8;strokeWidth=1.8;fontColor=#1A2C43;fontSize=20;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="22" y="414" width="316" height="101" as="geometry"/></mxCell>
        <mxCell id="t3" value='&lt;b&gt;4. Arrêt propre&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:17px"&gt;Borg à froid : disque,&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:17px"&gt;UEFI et TPM&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C4D5E8;strokeWidth=1.8;fontColor=#1A2C43;fontSize=20;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="22" y="548" width="316" height="101" as="geometry"/></mxCell>
        <mxCell id="b0" value='&lt;b&gt;5. Restauration&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:17px"&gt;original supprimé,&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:17px"&gt;VM restaurée démarrée&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C4D5E8;strokeWidth=1.8;fontColor=#1A2C43;fontSize=20;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="22" y="682" width="316" height="101" as="geometry"/></mxCell>
        <mxCell id="b1" value='&lt;b&gt;6. Reconstruction&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:17px"&gt;image neuve&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:17px"&gt;redémarrage et contrôles&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C4D5E8;strokeWidth=1.8;fontColor=#1A2C43;fontSize=20;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="22" y="816" width="316" height="101" as="geometry"/></mxCell>
        <mxCell id="b2" value='&lt;b&gt;7. Rapport&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:17px"&gt;preuves et journaux&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:17px"&gt;plantage = échec&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E8F6EF;strokeColor=#198263;strokeWidth=1.8;fontColor=#1A2C43;fontSize=20;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="22" y="950" width="316" height="101" as="geometry"/></mxCell>
