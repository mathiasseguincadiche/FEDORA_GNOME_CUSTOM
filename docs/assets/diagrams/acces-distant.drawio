        <mxCell id="tablet" value='&lt;b&gt;Tablette Android&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:13px"&gt;Moonlight · client SSH&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:13px"&gt;Tailscale&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#334155;strokeWidth=2;fontColor=#0F172A;fontSize=15;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="260" height="110" as="geometry"/></mxCell>
