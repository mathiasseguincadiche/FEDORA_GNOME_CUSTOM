<mxfile host="app.diagrams.net" type="device">
  <diagram id="chaine-qualification" name="La chaîne de qualification">
    <mxGraphModel dx="1320" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1320" pageHeight="600" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="La chaîne de qualification" style="text;html=1;fontSize=20;fontStyle=1;fontColor=#0F172A;fontFamily=Arial;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="32" y="22" width="1256" height="32" as="geometry"/></mxCell>
        <mxCell id="q0" value='&lt;b&gt;1. CI au commit exact&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:13px"&gt;GitHub : contrats,&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:13px"&gt;laboratoires QEMU&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#334155;strokeWidth=2;fontColor=#0F172A;fontSize=15;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="60" y="90" width="270" height="110" as="geometry"/></mxCell>
        <mxCell id="q1" value='&lt;b&gt;2. Live USB sur le PC&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:13px"&gt;PREINSTALL_ONLY&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:13px"&gt;preuve exportée&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#334155;strokeWidth=2;fontColor=#0F172A;fontSize=15;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="370" y="90" width="270" height="110" as="geometry"/></mxCell>
        <mxCell id="q2" value='&lt;b&gt;3. Accord du propriétaire&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:13px"&gt;résultats relus : GO / NO-GO&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:13px"&gt;avant tout effacement&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#B45309;strokeWidth=2;fontColor=#0F172A;fontSize=15;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="680" y="90" width="270" height="110" as="geometry"/></mxCell>
        <mxCell id="q3" value='&lt;b&gt;4. Installation&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:13px"&gt;Fedora sur le SSD&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:13px"&gt;import de la preuve Live&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#334155;strokeWidth=2;fontColor=#0F172A;fontSize=15;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="990" y="90" width="270" height="110" as="geometry"/></mxCell>
        <mxCell id="q4" value='&lt;b&gt;5. Baseline&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:13px"&gt;santé matérielle&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:13px"&gt;avant l&amp;#x27;APPLY&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#334155;strokeWidth=2;fontColor=#0F172A;fontSize=15;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="990" y="260" width="270" height="110" as="geometry"/></mxCell>
        <mxCell id="q5" value='&lt;b&gt;6. Dry-run&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:13px"&gt;plan de convergence&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:13px"&gt;aucun module appliqué&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#334155;strokeWidth=2;fontColor=#0F172A;fontSize=15;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="680" y="260" width="270" height="110" as="geometry"/></mxCell>
        <mxCell id="q6" value='&lt;b&gt;7. Sauvegarde&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:13px"&gt;Borg pré-APPLY&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:13px"&gt;vérifiée, canari restauré&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#334155;strokeWidth=2;fontColor=#0F172A;fontSize=15;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="370" y="260" width="270" height="110" as="geometry"/></mxCell>
        <mxCell id="q7" value='&lt;b&gt;8. APPLY protégé&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:13px"&gt;phrase de confirmation&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:13px"&gt;PC physique uniquement&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#334155;strokeWidth=2;fontColor=#0F172A;fontSize=15;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="60" y="260" width="270" height="110" as="geometry"/></mxCell>
        <mxCell id="q8" value='&lt;b&gt;9. Redémarrage&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:13px"&gt;Linux amont N&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#334155;strokeWidth=2;fontColor=#0F172A;fontSize=15;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="60" y="430" width="270" height="110" as="geometry"/></mxCell>
        <mxCell id="q9" value='&lt;b&gt;10. Gate 3&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:13px"&gt;doctors, cinq veilles&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:13px"&gt;certification du PC&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#1D4ED8;strokeWidth=2;fontColor=#0F172A;fontSize=15;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="370" y="430" width="270" height="110" as="geometry"/></mxCell>
        <mxCell id="q10" value='&lt;b&gt;11. Golden release&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:13px"&gt;statut certifié&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:13px"&gt;preuves liées à l&amp;#x27;état&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#15803D;strokeWidth=2;fontColor=#0F172A;fontSize=15;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="680" y="430" width="270" height="110" as="geometry"/></mxCell>
        <mxCell id="eq0" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#334155;strokeWidth=2;fontColor=#0F172A;fontSize=12;fontStyle=2;fontFamily=Arial;labelBackgroundColor=#FFFFFF;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;" edge="1" parent="1" source="q0" target="q1"><mxGeometry relative="1" as="geometry"><mxPoint x="330.0" y="145.0" as="sourcePoint"/><mxPoint x="370.0" y="145.0" as="targetPoint"/></mxGeometry></mxCell>
