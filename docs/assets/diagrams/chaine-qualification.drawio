<mxfile host="app.diagrams.net" type="device">
  <diagram id="chaine-qualification" name="De la CI à la certification du poste">
    <mxGraphModel dx="1440" dy="855" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1440" pageHeight="855" background="#F7F9FC" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="De la CI à la certification du poste" style="text;html=1;fontSize=29;fontStyle=1;fontColor=#1A2C43;fontFamily=Arial;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="23" width="1360" height="46" as="geometry"/></mxCell>
        <mxCell id="g_before" value="01  AVANT INSTALLATION" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D9E3EF;fontColor=#2959B4;fontStyle=1;fontSize=15;fontFamily=Arial;verticalAlign=top;align=left;spacingLeft=19;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="408" height="715" as="geometry"/></mxCell>
        <mxCell id="g_change" value="02  INSTALLER ET CONFIGURER" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D9E3EF;fontColor=#2959B4;fontStyle=1;fontSize=15;fontFamily=Arial;verticalAlign=top;align=left;spacingLeft=19;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="513" y="90" width="414" height="715" as="geometry"/></mxCell>
        <mxCell id="g_after" value="03  QUALIFIER ET PUBLIER" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D9E3EF;fontColor=#2959B4;fontStyle=1;fontSize=15;fontFamily=Arial;verticalAlign=top;align=left;spacingLeft=19;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="992" y="90" width="408" height="715" as="geometry"/></mxCell>
        <mxCell id="b0" value='&lt;b&gt;1. CI au commit exact&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:16px"&gt;Contrats et laboratoires logiciels&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C4D5E8;strokeWidth=1.8;fontColor=#1A2C43;fontSize=20;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="63" y="162" width="362" height="114" as="geometry"/></mxCell>
        <mxCell id="b1" value='&lt;b&gt;2. Gate 2 · Live USB&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:16px"&gt;PREINSTALL_ONLY · preuve exportée&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#346AC4;strokeWidth=1.8;fontColor=#1A2C43;fontSize=20;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="63" y="337" width="362" height="114" as="geometry"/></mxCell>
        <mxCell id="b2" value='&lt;b&gt;3. Revue et accord humain&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:16px"&gt;GO / NO-GO avant tout effacement&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF3DE;strokeColor=#AC731B;strokeWidth=1.8;fontColor=#1A2C43;fontSize=20;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="63" y="512" width="362" height="114" as="geometry"/></mxCell>
        <mxCell id="m0" value='&lt;b&gt;4. Installer Fedora&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:16px"&gt;SSD système et preuve Live importée&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C4D5E8;strokeWidth=1.8;fontColor=#1A2C43;fontSize=20;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="536" y="142" width="366" height="102" as="geometry"/></mxCell>
        <mxCell id="m1" value='&lt;b&gt;5. Certifier la baseline&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:16px"&gt;Contrôles de santé matérielle&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C4D5E8;strokeWidth=1.8;fontColor=#1A2C43;fontSize=20;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="536" y="270" width="366" height="102" as="geometry"/></mxCell>
        <mxCell id="m2" value='&lt;b&gt;6. Exécuter le dry-run&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:16px"&gt;Plan sans modification réelle&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C4D5E8;strokeWidth=1.8;fontColor=#1A2C43;fontSize=20;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="536" y="398" width="366" height="102" as="geometry"/></mxCell>
        <mxCell id="m3" value='&lt;b&gt;7. Sauvegarder avec Borg&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:16px"&gt;Pré-APPLY vérifié et canari restauré&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C4D5E8;strokeWidth=1.8;fontColor=#1A2C43;fontSize=20;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="536" y="526" width="366" height="102" as="geometry"/></mxCell>
        <mxCell id="m4" value='&lt;b&gt;8. Exécuter l&amp;#x27;APPLY&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:16px"&gt;Gardes et confirmation physique&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#346AC4;strokeWidth=1.8;fontColor=#1A2C43;fontSize=20;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="536" y="654" width="366" height="102" as="geometry"/></mxCell>
        <mxCell id="a0" value='&lt;b&gt;9. Redémarrer&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:16px"&gt;Linux amont N sur le vrai PC&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C4D5E8;strokeWidth=1.8;fontColor=#1A2C43;fontSize=20;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1014" y="162" width="362" height="114" as="geometry"/></mxCell>
        <mxCell id="a1" value='&lt;b&gt;10. Gate 3 · système installé&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:16px"&gt;Diagnostics et essais physiques&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#346AC4;strokeWidth=1.8;fontColor=#1A2C43;fontSize=20;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1014" y="337" width="362" height="114" as="geometry"/></mxCell>
        <mxCell id="a2" value='&lt;b&gt;11. Golden release&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:16px"&gt;Preuves courantes et certification&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E8F6EF;strokeColor=#198263;strokeWidth=1.8;fontColor=#1A2C43;fontSize=20;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1014" y="512" width="362" height="114" as="geometry"/></mxCell>
        <mxCell id="stage_one_to_two" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#547BB4;strokeWidth=2;fontColor=#1A2C43;fontSize=12;fontStyle=2;fontFamily=Arial;labelBackgroundColor=#FFFFFF;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;" edge="1" parent="1" source="g_before" target="g_change"><mxGeometry relative="1" as="geometry"><mxPoint x="448.0" y="447.5" as="sourcePoint"/><mxPoint x="513.0" y="447.5" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="stage_two_to_three" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#547BB4;strokeWidth=2;fontColor=#1A2C43;fontSize=12;fontStyle=2;fontFamily=Arial;labelBackgroundColor=#FFFFFF;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;" edge="1" parent="1" source="g_change" target="g_after"><mxGeometry relative="1" as="geometry"><mxPoint x="927.0" y="447.5" as="sourcePoint"/><mxPoint x="992.0" y="447.5" as="targetPoint"/></mxGeometry></mxCell>
