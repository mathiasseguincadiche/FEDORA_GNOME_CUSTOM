<mxfile host="app.diagrams.net" type="device">
  <diagram id="laboratoire-gnome" name="Le laboratoire Fedora/GNOME sur GitHub">
    <mxGraphModel dx="1320" dy="540" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1320" pageHeight="540" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="Le laboratoire Fedora/GNOME sur GitHub" style="text;html=1;fontSize=20;fontStyle=1;fontColor=#0F172A;fontFamily=Arial;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="32" y="22" width="1256" height="32" as="geometry"/></mxCell>
        <mxCell id="g_lab" value="Runner GitHub jetable : aucune commande sur le PC" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#334155;fontStyle=1;fontSize=14;fontFamily=Arial;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="30" y="70" width="1260" height="440" as="geometry"/></mxCell>
        <mxCell id="t0" value='&lt;b&gt;1. VM Fedora 45&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:13px"&gt;image Cloud finale&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:13px"&gt;signature et SHA-256&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#334155;strokeWidth=2;fontColor=#0F172A;fontSize=15;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="60" y="120" width="270" height="110" as="geometry"/></mxCell>
        <mxCell id="t1" value='&lt;b&gt;2. Dépôt et session&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:13px"&gt;GNOME 51 sous Wayland&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:13px"&gt;natif ou six extensions&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#334155;strokeWidth=2;fontColor=#0F172A;fontSize=15;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="370" y="120" width="270" height="110" as="geometry"/></mxCell>
        <mxCell id="t2" value='&lt;b&gt;3. Données témoin&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:13px"&gt;redémarrage&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:13px"&gt;persistance vérifiée&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#334155;strokeWidth=2;fontColor=#0F172A;fontSize=15;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="680" y="120" width="270" height="110" as="geometry"/></mxCell>
        <mxCell id="t3" value='&lt;b&gt;4. Arrêt propre&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:13px"&gt;Borg à froid : disque,&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:13px"&gt;UEFI et TPM&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#334155;strokeWidth=2;fontColor=#0F172A;fontSize=15;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="990" y="120" width="270" height="110" as="geometry"/></mxCell>
        <mxCell id="b0" value='&lt;b&gt;5. Restauration&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:13px"&gt;original supprimé,&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:13px"&gt;VM restaurée démarrée&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#334155;strokeWidth=2;fontColor=#0F172A;fontSize=15;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="990" y="340" width="270" height="110" as="geometry"/></mxCell>
        <mxCell id="b1" value='&lt;b&gt;6. Reconstruction&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:13px"&gt;image neuve&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:13px"&gt;redémarrage et contrôles&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#334155;strokeWidth=2;fontColor=#0F172A;fontSize=15;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="680" y="340" width="270" height="110" as="geometry"/></mxCell>
        <mxCell id="b2" value='&lt;b&gt;7. Rapport&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:13px"&gt;preuves et journaux&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:13px"&gt;plantage = échec&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#15803D;strokeWidth=2;fontColor=#0F172A;fontSize=15;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="370" y="340" width="270" height="110" as="geometry"/></mxCell>
