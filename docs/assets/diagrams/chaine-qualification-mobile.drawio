<mxfile host="app.diagrams.net" type="device">
  <diagram id="chaine-qualification-mobile" name="Qualifier le poste">
    <mxGraphModel dx="360" dy="1597" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="360" pageHeight="1597" background="#F7F9FC" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="Qualifier le poste" style="text;html=1;fontSize=29;fontStyle=1;fontColor=#1A2C43;fontFamily=Arial;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="23" width="280" height="46" as="geometry"/></mxCell>
        <mxCell id="section1" value="01 · AVANT INSTALLATION" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D9E3EF;fontColor=#2959B4;fontStyle=1;fontSize=17;fontFamily=Arial;verticalAlign=top;align=left;spacingLeft=19;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="10" y="90" width="340" height="410" as="geometry"/></mxCell>
        <mxCell id="section2" value="02 · INSTALLER ET CONFIGURER" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D9E3EF;fontColor=#2959B4;fontStyle=1;fontSize=17;fontFamily=Arial;verticalAlign=top;align=left;spacingLeft=19;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="10" y="536" width="340" height="609" as="geometry"/></mxCell>
        <mxCell id="section3" value="03 · QUALIFIER ET PUBLIER" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D9E3EF;fontColor=#2959B4;fontStyle=1;fontSize=17;fontFamily=Arial;verticalAlign=top;align=left;spacingLeft=19;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="10" y="1181" width="340" height="387" as="geometry"/></mxCell>
        <mxCell id="b0" value='&lt;b&gt;1. CI au commit exact&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:17px"&gt;Contrats et laboratoires&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C4D5E8;strokeWidth=1.8;fontColor=#1A2C43;fontSize=20;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="22" y="146" width="316" height="78" as="geometry"/></mxCell>
        <mxCell id="b1" value='&lt;b&gt;2. Gate 2 · Live USB&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:17px"&gt;PREINSTALL_ONLY · preuve&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:17px"&gt;exportée&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#346AC4;strokeWidth=1.8;fontColor=#1A2C43;fontSize=20;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="22" y="257" width="316" height="101" as="geometry"/></mxCell>
        <mxCell id="b2" value='&lt;b&gt;3. Revue et accord humain&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:17px"&gt;GO / NO-GO avant tout effacement&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF3DE;strokeColor=#AC731B;strokeWidth=1.8;fontColor=#1A2C43;fontSize=20;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="22" y="391" width="316" height="78" as="geometry"/></mxCell>
        <mxCell id="m0" value='&lt;b&gt;4. Installer Fedora&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:17px"&gt;SSD et preuve Live importée&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C4D5E8;strokeWidth=1.8;fontColor=#1A2C43;fontSize=20;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="22" y="592" width="316" height="78" as="geometry"/></mxCell>
        <mxCell id="m1" value='&lt;b&gt;5. Certifier la baseline&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:17px"&gt;Contrôles de santé matérielle&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C4D5E8;strokeWidth=1.8;fontColor=#1A2C43;fontSize=20;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="22" y="703" width="316" height="78" as="geometry"/></mxCell>
        <mxCell id="m2" value='&lt;b&gt;6. Exécuter le dry-run&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:17px"&gt;Plan sans modification réelle&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C4D5E8;strokeWidth=1.8;fontColor=#1A2C43;fontSize=20;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="22" y="814" width="316" height="78" as="geometry"/></mxCell>
        <mxCell id="m3" value='&lt;b&gt;7. Sauvegarder avec Borg&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:17px"&gt;Pré-APPLY et canari vérifiés&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C4D5E8;strokeWidth=1.8;fontColor=#1A2C43;fontSize=20;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="22" y="925" width="316" height="78" as="geometry"/></mxCell>
        <mxCell id="m4" value='&lt;b&gt;8. Exécuter l&amp;#x27;APPLY&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:17px"&gt;Gardes et confirmation physique&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#346AC4;strokeWidth=1.8;fontColor=#1A2C43;fontSize=20;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="22" y="1036" width="316" height="78" as="geometry"/></mxCell>
        <mxCell id="a0" value='&lt;b&gt;9. Redémarrer&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:17px"&gt;Linux amont N sur le vrai PC&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C4D5E8;strokeWidth=1.8;fontColor=#1A2C43;fontSize=20;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="22" y="1237" width="316" height="78" as="geometry"/></mxCell>
        <mxCell id="a1" value='&lt;b&gt;10. Gate 3 sur SSD&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:17px"&gt;Diagnostics et essais physiques&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#346AC4;strokeWidth=1.8;fontColor=#1A2C43;fontSize=20;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="22" y="1348" width="316" height="78" as="geometry"/></mxCell>
        <mxCell id="a2" value='&lt;b&gt;11. Golden release&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:17px"&gt;Preuves valides · certification&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E8F6EF;strokeColor=#198263;strokeWidth=1.8;fontColor=#1A2C43;fontSize=20;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="22" y="1459" width="316" height="78" as="geometry"/></mxCell>
