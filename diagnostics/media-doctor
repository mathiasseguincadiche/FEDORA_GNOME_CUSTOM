#!/usr/bin/env bash
set -Eeuo pipefail
REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source "$REPO_ROOT/lib/bootstrap.sh"; engine_bootstrap
quiet=false; [[ "${1:-}" == '--quiet' ]] && quiet=true
ok=0; warn=0; ko=0
record(){ local level="$1" label="$2" detail="$3"; case "$level" in OK)((ok+=1));; WARN)((warn+=1));; KO)((ko+=1));; esac; $quiet || ui_check "$level" "$label" "$detail"; }
required=(gstreamer1-plugins-base gstreamer1-plugins-good gstreamer1-plugins-bad-free gstreamer1-plugin-openh264 libvpl intel-vpl-gpu-rt)
is_true "${ENABLE_RPMFUSION:-true}" && required+=(ffmpeg ffmpegthumbnailer gstreamer1-plugins-bad-freeworld gstreamer1-plugins-ugly gstreamer1-plugin-libav)
for pkg in "${required[@]}"; do if rpm -q "$pkg" >/dev/null 2>&1; then record OK "$pkg" installed; else record KO "$pkg" missing; fi; done
if is_true "${ENABLE_RPMFUSION:-true}"; then if rpm -q ffmpeg-free >/dev/null 2>&1; then record KO FFmpeg 'ffmpeg-free still installed'; else record OK FFmpeg 'full provider selected'; fi; fi
if command_exists ffmpeg; then
  codecs="$(ffmpeg -hide_banner -decoders 2>/dev/null || true)"; for codec in h264 hevc av1 vp9 aac mp3 opus flac; do grep -Eqi "[[:space:]]${codec}([[:space:]]|$)" <<<"$codecs" && record OK "ffmpeg:$codec" decoder || record WARN "ffmpeg:$codec" 'decoder not matched'; done
  encoders="$(ffmpeg -hide_banner -encoders 2>/dev/null || true)"; for encoder in h264_vaapi hevc_vaapi av1_vaapi; do grep -Eq "[[:space:]]${encoder}([[:space:]]|$)" <<<"$encoders" && record OK "ffmpeg:$encoder" encoder || record KO "ffmpeg:$encoder" 'required B580 hardware encoder missing'; done
fi
if lspci -Dn 2>/dev/null | grep -Eqi '030[02]:[[:space:]]+8086:e20b'; then
  device="${VAAPI_DRM_DEVICE:-auto}"; [[ "$device" == auto ]] && device="$(drm_render_node_for_pci_id 8086 e20b 2>/dev/null || true)"
  if [[ -z "$device" || ! -e "$device" ]]; then record KO 'Arc B580 render node' 'no matching /dev/dri/renderD* node was proven'
  else
    record OK 'Arc B580 render node' "$device"
    report="$(vainfo --display drm --device "$device" 2>&1 || true)"
    [[ -n "$report" ]] || record KO VA-API "probe unavailable on $device"
    for profile in H264 HEVC AV1 VP9; do grep -q "VAProfile${profile}" <<<"$report" && record OK "VA-API:$profile" exposed || record KO "VA-API:$profile" missing; done
    grep -Eqi 'Intel.*iHD|iHD_drv_video' <<<"$report" && record OK 'VA-API driver' Intel-iHD || record WARN 'VA-API driver' 'Intel iHD not identified'
  fi
  if runtime_is_baremetal; then
    if bash "$REPO_ROOT/scripts/hardware/vaapi-smoke.sh" >"$REPORT_ROOT/$RUN_ID-vaapi-smoke.txt" 2>&1; then record OK 'VA-API functional' 'H264/HEVC/VP9/AV1 decode + H264/HEVC/AV1 encode PASS'; else record KO 'VA-API functional' "real codec exercise failed; see $REPORT_ROOT/$RUN_ID-vaapi-smoke.txt"; fi
  else record WARN 'VA-API functional' 'real GPU media test deferred outside bare-metal'; fi
fi
if ! $quiet; then ui_meta OK "$ok"; ui_meta WARN "$warn"; ui_meta KO "$ko"; fi
(( ko == 0 ))
