#!/usr/bin/env bash
set -Eeuo pipefail
REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source "$REPO_ROOT/lib/bootstrap.sh"; engine_bootstrap
source "$REPO_ROOT/modules/backup/60_daily_user_backup.sh"
quiet=false; [[ "${1:-}" == '--quiet' ]] && quiet=true
ok=0; warn=0; ko=0
emit(){ if ! $quiet; then ui_check "$1" "$2" "$3"; fi; case "$1" in OK)((ok+=1));; WARN)((warn+=1));; KO)((ko+=1));; esac; }

runtime_root="$(systemctl --user cat fedora-gnome-daily-backup.service 2>/dev/null | sed -n 's/^Environment="FEDORA_GNOME_CUSTOM_RUNTIME_ROOT=\(.*\)"$/\1/p' | tail -n1)"
if [[ -n "$runtime_root" ]] && backup_daily_existing_runtime_valid "$runtime_root" "$(repo_commit)"; then
  emit OK 'Backup runtime bundle' "$(basename "$runtime_root") integrity PASS"
else
  emit KO 'Backup runtime bundle' 'missing, integrity failure or stale source/configuration'
fi

if systemctl --user is-enabled --quiet fedora-gnome-daily-backup.timer; then
  emit OK 'Daily backup timer' enabled
else
  emit KO 'Daily backup timer' disabled
fi

if is_true "${BACKUP_RETENTION_TIMER_ENABLED:-true}" && is_true "${BACKUP_PRUNE_AUTOMATICALLY:-true}"; then
  if systemctl --user is-enabled --quiet fedora-gnome-backup-retention.timer; then
    emit OK 'Borg retention timer' "${BACKUP_RETENTION_ON_CALENDAR:-weekly}"
  else
    emit KO 'Borg retention timer' disabled
  fi
fi

runtime_state="${XDG_STATE_HOME:-$HOME/.local/state}/fedora-gnome-custom"
state="$runtime_state/last-daily-backup.ok"
if [[ -s "$runtime_state/last-daily-backup.failed" && ( ! -e "$runtime_state/last-daily-backup-skipped" || "$runtime_state/last-daily-backup.failed" -nt "$runtime_state/last-daily-backup-skipped" ) ]]; then
  emit KO 'Last daily backup' 'latest attempt failed; previous success cannot certify it'
elif [[ -s "$state" ]]; then
  marker_valid=true
  for field in verdict creation_rc; do
    value="$(evidence_marker_value "$state" "$field")"
    [[ ( "$field" == verdict && "$value" == PASS ) || ( "$field" == creation_rc && "$value" == 0 ) ]] || marker_valid=false
  done
  archive="$(evidence_marker_value "$state" archive)"
  snapshot="$(evidence_marker_value "$state" snapshot)"
  [[ "$snapshot" =~ ^[0-9a-f]{64}$ && "$archive" == fgc-daily-* ]] || marker_valid=false
  if ! $marker_valid; then emit KO 'Daily backup evidence' 'invalid success marker'; fi
  repository="$(backup_runtime_resolve_repository 2>/dev/null || true)"
  if [[ -z "$repository" ]]; then
    emit WARN 'Daily archive availability' 'repository unavailable; exact archive not verified'
  elif [[ "$repository" != "$(evidence_marker_value "$state" repository)" ]]; then
    emit KO 'Daily archive availability' 'repository differs from success marker'
  else
    backup_engine_env "$repository"
    if backup_engine_require && backup_engine_repo_ready && backup_engine_archive_matches "$archive" "$snapshot" daily; then
      emit OK 'Daily archive availability' 'exact name/id verified'
    else
      emit KO 'Daily archive availability' 'archive missing or repository invalid'
    fi
  fi
  ts="$(stat -c %Y "$state")"
  age_h=$(( ( $(date +%s) - ts ) / 3600 ))
  if (( age_h >= 0 && age_h <= ${DAILY_BACKUP_MAX_AGE_HOURS:-36} )); then
    emit OK 'Last daily backup' "${age_h}h old"
  else
    emit WARN 'Last daily backup' "${age_h}h old"
  fi
elif [[ -s "$runtime_state/last-daily-backup-skipped" ]]; then
  emit WARN 'Last daily backup' 'external disk / repository unavailable; timer remains healthy'
else
  emit WARN 'Last daily backup' 'timer installed; no run recorded yet'
fi

if [[ -s "$runtime_state/last-retention.ok" ]]; then
  emit OK 'Last Borg retention' recorded
elif [[ -s "$runtime_state/last-retention-skipped" ]]; then
  emit WARN 'Last Borg retention' 'repository unavailable during scheduled window'
else
  emit WARN 'Last Borg retention' 'timer installed; no run recorded yet'
fi

if ! $quiet; then ui_meta OK "$ok"; ui_meta WARN "$warn"; ui_meta KO "$ko"; fi
(( ko == 0 ))
