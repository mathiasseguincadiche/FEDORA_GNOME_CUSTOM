#!/usr/bin/env bash
set -Eeuo pipefail
REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source "$REPO_ROOT/lib/bootstrap.sh"; engine_bootstrap
quiet=false
[[ "${1:-}" == --quiet ]] && quiet=true
ok=0; warn=0; ko=0
emit(){ $quiet || ui_check "$1" "$2" "$3"; case "$1" in OK)((ok+=1));; WARN)((warn+=1));; KO)((ko+=1));; esac; }

[[ "${XDG_CURRENT_DESKTOP:-}" == *GNOME* ]] || { emit KO Session 'active GNOME session required'; exit "$EXIT_PRECHECK_FAILED"; }
if [[ "${XDG_SESSION_TYPE:-}" == wayland ]]; then emit OK Session 'GNOME/Wayland'; else emit KO Session "expected Wayland, got ${XDG_SESSION_TYPE:-unknown}"; fi
if pgrep -x gnome-shell >/dev/null 2>&1; then emit OK 'GNOME Shell process' running; else emit KO 'GNOME Shell process' missing; fi

if gdbus call --session --dest org.freedesktop.DBus --object-path /org/freedesktop/DBus --method org.freedesktop.DBus.NameHasOwner org.gnome.Shell 2>/dev/null | grep -Fq true; then
  emit OK 'GNOME Shell D-Bus' 'org.gnome.Shell owned'
else
  emit KO 'GNOME Shell D-Bus' 'org.gnome.Shell has no owner'
fi

for unit in xdg-desktop-portal.service pipewire.service wireplumber.service; do
  if systemctl --user is-active --quiet "$unit"; then emit OK "$unit" active; else emit KO "$unit" inactive; fi
done

check_extension_error(){
  local label="$1" uuid="$2" info
  [[ -n "$uuid" ]] || return 0
  info="$(gnome-extensions info "$uuid" 2>/dev/null || true)"
  if [[ -z "$info" ]]; then emit KO "$label" 'extension is not visible to GNOME Shell'; return; fi
  if grep -Eq 'State:[[:space:]]+(ERROR|OUT_OF_DATE)' <<<"$info"; then emit KO "$label" 'extension state ERROR/OUT_OF_DATE'; else emit OK "$label" 'extension runtime state healthy'; fi
}
if ! command -v gnome-extensions >/dev/null 2>&1; then emit KO Extensions 'gnome-extensions command missing'; fi
if is_true "${ENABLE_DASH_TO_DOCK:-false}"; then check_extension_error 'Dash to Dock' "${DASH_TO_DOCK_UUID:-dash-to-dock@micxgx.gmail.com}"; fi
if is_true "${ENABLE_APPINDICATOR:-false}"; then check_extension_error AppIndicator "${APPINDICATOR_UUID:-appindicatorsupport@rgcjonas.gmail.com}"; fi
if is_true "${ENABLE_DESKTOP_ICONS_NG:-false}"; then check_extension_error DING "${DING_UUID:-ding@rastersoft.com}"; fi
if is_true "${ENABLE_SHOW_DESKTOP_PLUS:-false}"; then check_extension_error 'Show Desktop Plus' "${SHOW_DESKTOP_PLUS_UUID:-show-desktop-plus@attentivecoder}"; fi
if is_true "${ENABLE_RESOURCE_MONITOR:-false}"; then check_extension_error 'Resource Monitor' "${RESOURCE_MONITOR_UUID:-Resource_Monitor@Ory0n}"; fi

journal="$(journalctl --user -b --no-pager -o cat 2>/dev/null || true)"
if grep -Eqi '(gnome-shell|mutter|gjs).*(segmentation fault|segfault|core dumped|fatal error|JS ERROR:)|xdg-desktop-portal.*(segmentation fault|segfault|core dumped)' <<<"$journal"; then
  emit KO 'GNOME journal' 'critical Shell/Mutter/GJS/portal crash signature in current boot'
else
  emit OK 'GNOME journal' 'no critical Shell/Mutter/GJS/portal crash signature in current boot'
fi

$quiet || { ui_meta OK "$ok"; ui_meta WARN "$warn"; ui_meta KO "$ko"; }
(( ko == 0 ))
