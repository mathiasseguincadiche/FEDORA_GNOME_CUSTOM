#!/usr/bin/env bash
set -Eeuo pipefail
REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source "$REPO_ROOT/lib/bootstrap.sh"; engine_bootstrap

quiet=false
[[ "${1:-}" == "--quiet" ]] && quiet=true
ok=0; warn=0; ko=0

record() {
  local level="$1" label="$2" detail="$3"
  case "$level" in OK) ((ok+=1));; WARN) ((warn+=1));; KO) ((ko+=1));; esac
  $quiet || ui_check "$level" "$label" "$detail"
}

vsh() {
  if virsh --connect "${LIBVIRT_URI:-qemu:///system}" list --all >/dev/null 2>&1; then
    virsh --connect "${LIBVIRT_URI:-qemu:///system}" "$@"
  elif sudo -n virsh --connect "${LIBVIRT_URI:-qemu:///system}" list --all >/dev/null 2>&1; then
    sudo -n virsh --connect "${LIBVIRT_URI:-qemu:///system}" "$@"
  else
    return 1
  fi
}

if grep -Eq 'svm|AMD-V' <(lscpu 2>/dev/null); then record OK AMD-V enabled; else record KO AMD-V missing; fi
if [[ -c /dev/kvm ]]; then record OK /dev/kvm present; else record KO /dev/kvm missing; fi
if [[ -d /sys/module/kvm_amd ]]; then record OK kvm_amd loaded; else record KO kvm_amd missing; fi

arc_driver=""
for dev in /sys/bus/pci/devices/*; do
  [[ -r "$dev/vendor" && -r "$dev/device" ]] || continue
  if [[ "$(normalize_hex "$(<"$dev/vendor")")" == 8086 && "$(normalize_hex "$(<"$dev/device")")" == e20b ]]; then
    [[ -L "$dev/driver" ]] && arc_driver="$(basename "$(readlink -f "$dev/driver")")"
    break
  fi
done
[[ "$arc_driver" == xe ]] && record OK 'Arc B580' 'HOST driver=xe' || record KO 'Arc B580' "driver=${arc_driver:-missing}"
is_true "${ALLOW_GPU_PASSTHROUGH:-false}" && record KO VFIO 'passthrough enabled by config' || record OK VFIO 'GPU passthrough disabled'

for cmd in \
  virsh virt-admin virt-host-validate virt-xml-validate \
  qemu-img qemu-io qemu-nbd qemu-storage-daemon \
  virt-install virt-clone virt-xml virt-manager virt-viewer remote-viewer \
  swtpm swtpm_setup virtiofsd osinfo-query cloud-localds openssl \
  guestfish virt-filesystems virt-customize virt-sysprep virt-resize virt-sparsify virt-builder \
  virt-top virt-v2v virt-qemu-qmp-proxy ssh scp sftp rsync; do
  command_exists "$cmd" && record OK "$cmd" available || record KO "$cmd" missing
done

virt-host-validate qemu >/dev/null 2>&1 \
  && record OK 'Host validation' 'virt-host-validate qemu passed' \
  || record WARN 'Host validation' 'recommendations reported; inspect before heavy VM use'

if systemctl is-active --quiet virtqemud.socket 2>/dev/null; then
  record OK libvirt 'virtqemud socket active'
elif systemctl is-active --quiet libvirtd.socket 2>/dev/null || systemctl is-active --quiet libvirtd.service 2>/dev/null; then
  record OK libvirt 'legacy compatibility endpoint active'
else
  record KO libvirt 'no QEMU libvirt activation endpoint active'
fi

vsh list --all >/dev/null 2>&1 && record OK qemu:///system reachable || record KO qemu:///system 'connection unavailable'

mount="${KVM_DATA_MOUNT:-/data}"
target="$(findmnt -n -T "$mount" -o TARGET 2>/dev/null || true)"
fstype="$(findmnt -n -T "$mount" -o FSTYPE 2>/dev/null || true)"
[[ "$target" == "$mount" && "$fstype" == "${KVM_DATA_FSTYPE:-ext4}" ]] \
  && record OK 'KVM storage mount' "$mount $fstype" \
  || record KO 'KVM storage mount' "target=${target:-missing} fstype=${fstype:-unknown}"

pool="${KVM_POOL_NAME:-devops-data}"
if vsh pool-info "$pool" >/dev/null 2>&1; then
  pool_info="$(vsh pool-info "$pool" 2>/dev/null || true)"
  grep -Eq '^State:[[:space:]]+running' <<<"$pool_info" && record OK 'Storage pool' running || record KO 'Storage pool' inactive
  grep -Eq '^Autostart:[[:space:]]+yes' <<<"$pool_info" && record OK 'Pool autostart' enabled || record KO 'Pool autostart' disabled
else
  record KO 'Storage pool' missing
fi

[[ "$(getenforce 2>/dev/null || true)" == Enforcing ]] && record OK SELinux Enforcing || record KO SELinux 'not Enforcing'
storage_root="${KVM_DATA_MOUNT:-/data}/libvirt/images"
if [[ -e "$storage_root" ]]; then
  label="$(ls -Zd "$storage_root" 2>/dev/null || true)"
  grep -Fq "${KVM_STORAGE_SELINUX_TYPE:-virt_image_t}" <<<"$label" \
    && record OK 'Storage SELinux' "${KVM_STORAGE_SELINUX_TYPE:-virt_image_t}" \
    || record KO 'Storage SELinux' 'unexpected label'
fi

find /usr/share -maxdepth 5 -type f \( -name 'OVMF_CODE*.fd' -o -path '*/qemu/firmware/*.json' \) -print -quit 2>/dev/null | grep -q . \
  && record OK OVMF available || record KO OVMF missing
swtpm --version >/dev/null 2>&1 && record OK 'TPM emulator' swtpm || record KO 'TPM emulator' unavailable

network="${KVM_NETWORK_NAME:-devops-nat}"
if vsh net-info "$network" >/dev/null 2>&1; then
  net_info="$(vsh net-info "$network" 2>/dev/null || true)"
  grep -Eq '^Active:[[:space:]]+yes' <<<"$net_info" && record OK "$network" active || record KO "$network" inactive
  grep -Eq '^Autostart:[[:space:]]+yes' <<<"$net_info" && record OK 'Network autostart' enabled || record KO 'Network autostart' disabled
  net_xml="$(vsh net-dumpxml "$network" 2>/dev/null || true)"
  grep -Fq "<bridge name='${KVM_BRIDGE_NAME:-virbr50}'" <<<"$net_xml" && record OK 'Network bridge' "${KVM_BRIDGE_NAME:-virbr50}" || record KO 'Network bridge' mismatch
  if grep -Fq "<forwarder addr='${KVM_DNS_1:-9.9.9.9}'" <<<"$net_xml" && grep -Fq "<forwarder addr='${KVM_DNS_2:-1.1.1.1}'" <<<"$net_xml"; then
    record OK DNS 'explicit Quad9/Cloudflare forwarders'
  else
    record KO DNS 'forwarder mismatch'
  fi
else
  record KO "$network" missing
fi

if firewall-cmd --state >/dev/null 2>&1; then
  record OK firewalld active
  zone="$(firewall-cmd --get-zone-of-interface="${KVM_BRIDGE_NAME:-virbr50}" 2>/dev/null || true)"
  [[ "$zone" == "${KVM_FIREWALLD_ZONE:-libvirt}" ]] && record OK 'firewalld zone' "$zone" || record KO 'firewalld zone' "${zone:-unassigned}"
else
  record KO firewalld inactive
fi

if is_true "${KVM_BLOCK_PHYSICAL_LAN:-true}"; then
  if sudo -n nft list table inet "${KVM_NFT_TABLE:-fedora_gnome_custom_kvm}" >/dev/null 2>&1; then
    rules="$(sudo -n nft list table inet "${KVM_NFT_TABLE:-fedora_gnome_custom_kvm}" 2>/dev/null || true)"
    grep -Fq 'block VM to physical LAN' <<<"$rules" && record OK 'LAN isolation' enforced || record KO 'LAN isolation' 'guard rule missing'
  elif systemctl is-active --quiet fedora-gnome-custom-kvm-guard.service 2>/dev/null; then
    record WARN 'LAN isolation' 'guard service active; privileged nft inspection unavailable'
  else
    record KO 'LAN isolation' 'guard inactive'
  fi
fi

osinfo-query os >/dev/null 2>&1 && record OK libosinfo catalog || record KO libosinfo unavailable
rpm -q libvirt-nss >/dev/null 2>&1 && record OK 'libvirt NSS' installed || record KO 'libvirt NSS' missing
rpm -q cloud-utils-cloud-localds >/dev/null 2>&1 && record OK 'cloud-init seed tooling' cloud-localds || record KO 'cloud-init seed tooling' missing
rpm -q openssl >/dev/null 2>&1 && record OK 'password hash tooling' openssl || record KO 'password hash tooling' missing

if [[ "${UBUNTU_SERVER_RELEASE:-}" == 26.04 \
   && "${UBUNTU_SERVER_VCPU:-}" == 6 \
   && "${UBUNTU_SERVER_RAM_MB:-}" == 16384 \
   && "${UBUNTU_SERVER_DISK_GB:-}" == 160 \
   && "${WINDOWS11_VCPU:-}" == 4 \
   && "${WINDOWS11_RAM_MB:-}" == 12288 \
   && "${WINDOWS11_DISK_GB:-}" == 128 \
   && -z "${FEDORA_VM_NAME:-}" ]]; then
  record OK 'VM profiles' 'Ubuntu Server 26.04 + Windows 11 final contract'
else
  record KO 'VM profiles' 'profile resources or guest set mismatch'
fi

for helper in \
  guest/ubuntu-devops/bootstrap-devops.sh guest/ubuntu-devops/verify-devops.sh \
  scripts/kvm/create_ubuntu_devops_vm.sh scripts/kvm/create_windows11_vm.sh scripts/kvm/runtime_certification.sh; do
  [[ -r "$REPO_ROOT/$helper" ]] && record OK "$helper" present || record KO "$helper" missing
done

record WARN 'Runtime guest proof' 'run scripts/kvm/runtime_certification.sh after both real guests are created'

if ! $quiet; then
  ui_meta OK "$ok"; ui_meta WARN "$warn"; ui_meta KO "$ko"
  ((ko == 0)) \
    && ui_summary 'VIRTUALIZATION STACK HEALTHY' 'RUNTIME GUEST CERTIFICATION NEXT' "$REPORT_ROOT" "$LOG_DIR" \
    || ui_summary 'VIRTUALIZATION NEEDS ATTENTION' 'FIX KO BEFORE KVM USE' "$REPORT_ROOT" "$LOG_DIR"
fi
((ko == 0))
