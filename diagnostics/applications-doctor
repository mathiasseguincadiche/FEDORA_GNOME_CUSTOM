#!/usr/bin/env bash
set -Eeuo pipefail
REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source "$REPO_ROOT/lib/bootstrap.sh"; engine_bootstrap
# shellcheck disable=SC1090
source "$REPO_ROOT/modules/applications/42_dock_favorites.sh"

quiet=false
[[ "${1:-}" == '--quiet' ]] && quiet=true
ok=0; ko=0

emit() {
  local status="$1" name="$2" detail="$3"
  if ! $quiet; then ui_check "$status" "$name" "$detail"; fi
  case "$status" in OK) ((ok+=1));; KO) ((ko+=1));; esac
}

while IFS= read -r pkg; do
  [[ -z "$pkg" || "$pkg" == \#* ]] && continue
  if ! rpm -q "$pkg" >/dev/null 2>&1; then
    emit KO "$pkg" 'not installed'
    continue
  fi
  requirements="$(rpm -q --requires "$pkg" 2>/dev/null || true)"
  if ! grep -Eqi 'gtk4|libgtk-4\.so\.1' <<<"$requirements"; then
    emit KO "$pkg" 'GTK4 requirement not visible in installed RPM metadata'
    continue
  fi
  if ! grep -Eqi 'libadwaita|libadwaita-1\.so\.0' <<<"$requirements"; then
    emit KO "$pkg" 'libadwaita requirement not visible in installed RPM metadata'
    continue
  fi
  emit OK "$pkg" 'GTK4 + libadwaita'
done < "$REPO_ROOT/manifests/packages-applications-gtk4.txt"

if is_true "${ENABLE_PROFESSIONAL_APPLICATIONS:-true}"; then
  for manifest in \
    "$REPO_ROOT/manifests/packages-applications-professional-fedora.txt" \
    "$REPO_ROOT/manifests/packages-applications-professional-vendor.txt"; do
    while IFS= read -r pkg; do
      [[ -z "$pkg" || "$pkg" == \#* ]] && continue
      if rpm -q "$pkg" >/dev/null 2>&1; then
        emit OK "$pkg" 'professional RPM installed'
      else
        emit KO "$pkg" 'professional RPM missing'
      fi
    done < "$manifest"
  done

  if is_true "${ENABLE_PROFESSIONAL_FLATPAKS:-true}"; then
    while IFS= read -r app; do
      [[ -z "$app" || "$app" == \#* ]] && continue
      if flatpak info "$app" >/dev/null 2>&1; then
        emit OK "$app" 'professional Flatpak installed'
      else
        emit KO "$app" 'professional Flatpak missing'
      fi
    done < "$REPO_ROOT/manifests/flatpaks-applications-professional.txt"
  fi
fi

if command_exists "${TERMINAL_PACKAGE:-ptyxis}"; then
  emit OK Terminal "${TERMINAL_PACKAGE:-ptyxis}"
else
  emit KO Terminal "${TERMINAL_PACKAGE:-ptyxis} missing"
fi

if rpm -q "${TEXT_EDITOR_PACKAGE:-gnome-text-editor}" >/dev/null 2>&1; then
  emit OK 'Text editor' "${TEXT_EDITOR_PACKAGE:-gnome-text-editor}"
else
  emit KO 'Text editor' "${TEXT_EDITOR_PACKAGE:-gnome-text-editor} missing"
fi

if is_true "${GNOME_DOCK_FAVORITES_ENABLED:-true}"; then
  expected="$(dock_favorites_variant)"
  actual="$(gsettings get org.gnome.shell favorite-apps 2>/dev/null || true)"
  if [[ "$actual" == "$expected" ]]; then
    emit OK 'GNOME dock' 'curated favorites exact order'
  else
    emit KO 'GNOME dock' "favorites mismatch: ${actual:-unavailable}"
  fi
  read -r -a dock_apps <<< "${GNOME_DOCK_FAVORITES:-}"
  for app in "${dock_apps[@]}"; do
    if dock_launcher_exists "$app"; then
      emit OK "Dock launcher $app" exported
    else
      emit KO "Dock launcher $app" missing
    fi
  done
fi

if ! $quiet; then
  ui_meta OK "$ok"
  ui_meta KO "$ko"
fi
(( ko == 0 ))
