#!/usr/bin/env bash
set -Eeuo pipefail
REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source "$REPO_ROOT/lib/bootstrap.sh"; engine_bootstrap
source "$REPO_ROOT/lib/performance_runtime.sh"
quiet=false; core=false
for arg in "$@"; do case "$arg" in --quiet) quiet=true;; --core) core=true;; *) echo 'Usage: performance-doctor [--quiet] [--core]' >&2; exit "$EXIT_USAGE";; esac; done
ok=0; warn=0; ko=0
emit(){ $quiet || ui_check "$1" "$2" "$3"; case "$1" in OK)((ok+=1));; WARN)((warn+=1));; KO)((ko+=1));; esac; }
performance_runtime_validate_policy || { emit KO Policy 'invalid performance-runtime.policy'; exit 1; }
emit OK Policy 'Fedora-Cachy runtime policy valid'

driver="$(performance_cpu_scaling_driver || true)"; pstate="$(performance_amd_pstate_status || true)"; boost="$(performance_cpu_boost || true)"
if [[ "$driver" =~ ^(amd-pstate|amd-pstate-epp|amd_pstate|amd_pstate_epp)$ ]]; then emit OK 'AMD P-State' "$driver status=${pstate:-unknown}"; else emit KO 'AMD P-State' "driver=${driver:-unknown}"; fi
[[ "$boost" == 1 ]] && emit OK Boost enabled || emit WARN Boost "value=${boost:-unknown}"
if [[ "$pstate" == "$(performance_policy_get amd_pstate_mode)" ]]; then emit OK 'P-State mode' "$pstate"; else emit WARN 'P-State mode' "runtime=${pstate:-unknown} target=$(performance_policy_get amd_pstate_mode)"; fi

epp="$(performance_epp_values | paste -sd, -)"
if [[ -n "$epp" ]]; then emit OK EPP "$epp"; else emit WARN EPP 'energy_performance_preference not exposed'; fi
if systemctl is-active --quiet tuned.service; then emit OK TuneD active; else emit KO TuneD inactive; fi
if systemctl is-active --quiet tuned-ppd.service; then emit OK 'TuneD PPD' active; else emit WARN 'TuneD PPD' inactive; fi
active="$(performance_tuned_active_profile || true)"
[[ -n "$active" ]] && emit OK 'TuneD profile' "$active" || emit WARN 'TuneD profile' unknown

if $core; then
  $quiet || { ui_meta OK "$ok"; ui_meta WARN "$warn"; ui_meta KO "$ko"; }
  ((ko == 0))
  exit
fi

if "$REPO_ROOT/diagnostics/zram-doctor" --quiet; then emit OK ZRAM 'Fedora-default contract'; else emit KO ZRAM 'zram package/runtime contract failed'; fi
if "$REPO_ROOT/diagnostics/sched-ext-doctor" --quiet; then emit OK sched_ext 'optional capability is fail-safe'; else emit KO sched_ext 'required sched_ext contract failed'; fi
if "$REPO_ROOT/diagnostics/nvme-scheduler-doctor" --quiet; then emit OK 'NVMe policy' 'benchmark-only; no blind scheduler mutation'; else emit KO 'NVMe policy' invalid; fi
if is_true "${GAMING_ENABLE:-false}" && [[ "$(performance_policy_get gamemode_dynamic)" == true ]]; then
  command -v gamemoderun >/dev/null 2>&1 && emit OK GameMode 'dynamic per-game policy available' || emit KO GameMode missing
fi
$quiet || { ui_meta OK "$ok"; ui_meta WARN "$warn"; ui_meta KO "$ko"; }
((ko == 0))
