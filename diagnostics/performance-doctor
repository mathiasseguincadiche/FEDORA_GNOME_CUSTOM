#!/usr/bin/env bash
set -Eeuo pipefail
REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source "$REPO_ROOT/lib/bootstrap.sh"; engine_bootstrap
source "$REPO_ROOT/lib/performance_runtime.sh"

quiet=false
core=false
certify=false
for arg in "$@"; do
  case "$arg" in
    --quiet) quiet=true ;;
    --core) core=true ;;
    --certify) certify=true ;;
    *) echo 'Usage: performance-doctor [--quiet] [--core|--certify]' >&2; exit "$EXIT_USAGE" ;;
  esac
done

ok=0
warn=0
ko=0
emit(){
  $quiet || ui_check "$1" "$2" "$3"
  case "$1" in
    OK) ((ok+=1)) ;;
    WARN) ((warn+=1)) ;;
    KO) ((ko+=1)) ;;
  esac
}

performance_runtime_validate_policy || { emit KO Policy 'invalid performance-runtime.policy'; exit 1; }
emit OK Policy 'Fedora-Cachy runtime policy valid'

driver="$(performance_cpu_scaling_driver || true)"
pstate="$(performance_amd_pstate_status || true)"
boost="$(performance_cpu_boost || true)"
if [[ "$(performance_policy_get require_amd_pstate)" == true ]]; then
  if [[ "$driver" =~ ^(amd-pstate|amd-pstate-epp|amd_pstate|amd_pstate_epp)$ ]]; then
    emit OK 'AMD P-State' "$driver status=${pstate:-unknown}"
  else
    emit KO 'AMD P-State' "required driver missing; runtime=${driver:-unknown}"
  fi
else
  emit OK 'AMD P-State policy' optional
fi

if [[ "$boost" == 1 ]]; then
  emit OK Boost enabled
elif $certify; then
  emit KO Boost "Golden certification requires CPU boost; value=${boost:-unknown}"
else
  emit WARN Boost "value=${boost:-unknown}"
fi
if [[ "$pstate" == "$(performance_policy_get amd_pstate_mode)" ]]; then
  emit OK 'P-State mode' "$pstate"
elif $certify && [[ "$(performance_policy_get require_amd_pstate)" == true ]]; then
  emit KO 'P-State mode' "runtime=${pstate:-unknown} target=$(performance_policy_get amd_pstate_mode)"
else
  emit WARN 'P-State mode' "runtime=${pstate:-unknown} target=$(performance_policy_get amd_pstate_mode)"
fi

epp="$(performance_epp_values | paste -sd, -)"
if [[ -n "$epp" ]]; then
  emit OK EPP "$epp"
elif $certify && [[ "$(performance_policy_get require_amd_pstate)" == true && "$(performance_policy_get amd_pstate_mode)" == active ]]; then
  emit KO EPP 'Golden certification expects energy_performance_preference with AMD P-State active'
else
  emit WARN EPP 'energy_performance_preference not exposed'
fi

active=''
mode=''
if [[ "$(performance_policy_get tuned_enabled)" == true ]]; then
  if systemctl is-active --quiet tuned.service; then emit OK TuneD active; else emit KO TuneD inactive; fi
  if systemctl is-active --quiet tuned-ppd.service; then
    emit OK 'TuneD PPD' active
  elif $certify; then
    emit KO 'TuneD PPD' 'Golden certification requires tuned-ppd active'
  else
    emit WARN 'TuneD PPD' inactive
  fi
  active="$(performance_tuned_active_profile || true)"
  mode="$(performance_mode_from_tuned_profile "$active" 2>/dev/null || true)"
  if [[ -n "$active" && -n "$mode" ]]; then
    emit OK 'TuneD profile' "$active (mode=$mode)"
  elif [[ -n "$active" ]]; then
    emit WARN 'TuneD profile' "$active is outside the versioned Golden profile map"
  else
    emit WARN 'TuneD profile' unknown
  fi

  if [[ -n "$mode" && -n "$epp" ]]; then
    expected_epp="$(performance_profile_expected_epp "$mode")"
    if [[ ",$epp," == *",$expected_epp,"* ]]; then
      emit OK 'EPP/profile' "$mode -> $expected_epp"
    elif $certify; then
      emit KO 'EPP/profile' "mode=$mode expected=$expected_epp runtime=$epp"
    else
      emit WARN 'EPP/profile' "mode=$mode expected=$expected_epp runtime=$epp"
    fi
  fi

  if $certify; then
    expected_profile="$(performance_profile_tuned_name "$(performance_policy_get mode_default)")"
    if [[ "$active" == "$expected_profile" ]]; then
      emit OK 'Golden performance mode' "$expected_profile"
    else
      emit KO 'Golden performance mode' "certification requires $expected_profile; runtime=${active:-unknown}"
    fi
  fi
else
  emit OK TuneD 'disabled by versioned policy'
fi

if $core; then
  $quiet || { ui_meta OK "$ok"; ui_meta WARN "$warn"; ui_meta KO "$ko"; }
  ((ko == 0))
  exit
fi

if $certify; then
  if "$REPO_ROOT/diagnostics/zram-doctor" --quiet --certify; then emit OK ZRAM 'Fedora-default runtime active'; else emit KO ZRAM 'Golden zram runtime contract failed'; fi
else
  if "$REPO_ROOT/diagnostics/zram-doctor" --quiet; then emit OK ZRAM 'Fedora-default contract'; else emit KO ZRAM 'zram package/runtime contract failed'; fi
fi
if "$REPO_ROOT/diagnostics/sched-ext-doctor" --quiet; then emit OK sched_ext 'optional capability is fail-safe'; else emit KO sched_ext 'required sched_ext contract failed'; fi
if "$REPO_ROOT/diagnostics/nvme-scheduler-doctor" --quiet; then emit OK 'NVMe policy' 'benchmark-only; no blind scheduler mutation'; else emit KO 'NVMe policy' invalid; fi
if is_true "${GAMING_ENABLE:-false}" && [[ "$(performance_policy_get gamemode_dynamic)" == true ]]; then
  if command -v gamemoderun >/dev/null 2>&1; then emit OK GameMode 'dynamic per-game policy available'; else emit KO GameMode missing; fi
fi

$quiet || { ui_meta OK "$ok"; ui_meta WARN "$warn"; ui_meta KO "$ko"; }
((ko == 0))
