#!/usr/bin/env bash
set -Eeuo pipefail
REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source "$REPO_ROOT/lib/bootstrap.sh"; engine_bootstrap
ok=0; warn=0; ko=0
record() { local s="$1" n="$2" d="$3"; ui_check "$s" "$n" "$d"; case "$s" in OK) ((ok+=1));; WARN) ((warn+=1));; KO) ((ko+=1));; esac; }
[[ "${XDG_SESSION_TYPE:-}" == wayland ]] && record OK session Wayland || record KO session "${XDG_SESSION_TYPE:-unknown}"
lspci -nnk -d 8086:e20b 2>/dev/null | grep -Fq 'Kernel driver in use: xe' && record OK renderer 'Arc B580 / xe' || record KO renderer incorrect
if command -v gdbus >/dev/null 2>&1; then state="$(gdbus call --session --dest org.gnome.Mutter.DisplayConfig --object-path /org/gnome/Mutter/DisplayConfig --method org.gnome.Mutter.DisplayConfig.GetCurrentState 2>/dev/null || true)"; if grep -q "$EXPECTED_WIDTH" <<< "$state" && grep -q "$EXPECTED_HEIGHT" <<< "$state"; then record OK resolution "${EXPECTED_WIDTH}x${EXPECTED_HEIGHT}"; else record WARN resolution 'expected mode not proven by Mutter'; fi; grep -Eq '240([.]0+)?' <<< "$state" && record OK refresh '~240 Hz' || record WARN refresh '240 Hz not proven by Mutter'; else record WARN Mutter 'D-Bus unavailable'; fi
if command -v gsettings >/dev/null 2>&1; then scale="$(gsettings get org.gnome.desktop.interface text-scaling-factor 2>/dev/null || true)"; record OK text-scale "${scale:-unknown}"; font="$(gsettings get org.gnome.desktop.interface font-name 2>/dev/null || true)"; record OK font "${font:-unknown}"; fi
if command -v fc-match >/dev/null 2>&1; then record OK fontconfig "$(fc-match sans | head -n1)"; fi
errors="$(journalctl -k -b --no-pager 2>/dev/null | grep -Ei '\b(xe|drm)\b.*(hang|reset|wedged|fault|error)' | tail -n 10 || true)"; [[ -z "$errors" ]] && record OK 'xe/DRM journal' clean || record WARN 'xe/DRM journal' 'matching events found'
ui_meta OK "$ok"; ui_meta WARN "$warn"; ui_meta KO "$ko"; (( ko == 0 ))
