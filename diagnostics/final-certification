#!/usr/bin/env bash
set -Eeuo pipefail
REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source "$REPO_ROOT/lib/bootstrap.sh"; engine_bootstrap
final_dir="$STATE_ROOT/final"; evidence_dir="$final_dir/evidence"; cert="$final_dir/certified.ok"; mkdir -p "$evidence_dir"
require_baremetal(){ runtime_is_baremetal || { ui_error 'Final certification is bare-metal only'; exit "$EXIT_SECURITY_BLOCK"; }; }
final_fingerprint(){ printf '%s|kernel=%s' "$(baseline_fingerprint)" "$(uname -r)" | sha256sum | awk '{print $1}'; }
suspend_count(){ local f c=0; shopt -s nullglob; for f in "$evidence_dir"/suspend-*.ok; do grep -Fxq "fingerprint=$(final_fingerprint)" "$f" && ((c+=1)); done; shopt -u nullglob; printf '%d\n' "$c"; }
record_suspend(){ require_baremetal; "$REPO_ROOT/diagnostics/kernel-doctor" --quiet; "$REPO_ROOT/diagnostics/graphics-doctor" --quiet; "$REPO_ROOT/diagnostics/display-doctor" --quiet; local marker="$HOME/.local/state/fedora-gnome-custom/display-repair-last.txt" now ts age n; [[ -s "$marker" ]] || { ui_error 'No display repair marker after resume'; exit "$EXIT_POSTCHECK_FAILED"; }; now="$(date +%s)"; ts="$(stat -c %Y "$marker")"; age=$((now-ts)); (( age >= 0 && age <= 300 )) || { ui_error "Display repair marker is stale (${age}s); resume/display repair was not just verified"; exit "$EXIT_POSTCHECK_FAILED"; }; ! journalctl -k -b --since '-10 min' --no-pager 2>/dev/null | grep -Eqi '\bxe\b.*(wedged|reset failed|gpu hang)|PCIe Bus Error: severity=Uncorrected|nvme.*(I/O error|reset controller)' || { ui_error 'Critical kernel/xe/PCIe/NVMe signal after recent suspend'; exit "$EXIT_POSTCHECK_FAILED"; }; n=$(( $(suspend_count)+1 )); { printf 'fingerprint=%s\nutc=%s\nrepair_marker_age_s=%s\n' "$(final_fingerprint)" "$(date -u +%FT%TZ)" "$age"; } > "$evidence_dir/suspend-$(printf '%02d' "$n").ok"; ui_check OK suspend-cycle "$n / ${FINAL_CERT_MIN_SUSPEND_CYCLES:-5}"; }
valid_coldstart(){ local f="$evidence_dir/nautilus-coldstart.ok"; [[ -s "$f" ]] && grep -Fxq "fingerprint=$(final_fingerprint)" "$f" && awk -F= -v max="${NAUTILUS_COLDSTART_HARD_LIMIT_MS:-2000}" '$1=="elapsed_ms" {exit !($2<=max)}' "$f"; }
certify(){ require_baremetal; baseline_certification_valid || { ui_error 'Pre-APPLY hardware baseline is not valid'; exit "$EXIT_PRECHECK_FAILED"; }; "$REPO_ROOT/diagnostics/kernel-doctor" --quiet; "$REPO_ROOT/diagnostics/graphics-doctor" --quiet; "$REPO_ROOT/diagnostics/display-doctor" --quiet; "$REPO_ROOT/diagnostics/gnome-doctor" --quiet; (( $(suspend_count) >= ${FINAL_CERT_MIN_SUSPEND_CYCLES:-5} )) || { ui_error 'Not enough post-APPLY suspend/resume cycles'; exit "$EXIT_PRECHECK_FAILED"; }; valid_coldstart || { ui_error 'Current-kernel Nautilus cold-start evidence missing or above hard limit; run nautilus-coldstart-doctor immediately after login'; exit "$EXIT_PRECHECK_FAILED"; }; { printf 'verdict=PASS\nfingerprint=%s\nkernel=%s\ncertified_utc=%s\nsuspend_cycles=%s\n' "$(final_fingerprint)" "$(uname -r)" "$(date -u +%FT%TZ)" "$(suspend_count)"; } > "$cert"; ui_check OK 'Golden workstation' "$cert"; }
status(){ ui_banner 'GOLDEN WORKSTATION' 'POST-APPLY CERTIFICATION'; ui_meta Kernel "$(uname -r)"; ui_meta Fingerprint "$(final_fingerprint)"; ui_meta 'Suspend PASS cycles' "$(suspend_count) / ${FINAL_CERT_MIN_SUSPEND_CYCLES:-5}"; valid_coldstart && ui_check OK 'Nautilus cold-start' PASS || ui_check WARN 'Nautilus cold-start' missing; if [[ -s "$cert" ]] && grep -Fxq "fingerprint=$(final_fingerprint)" "$cert"; then ui_check OK Certification valid; else ui_check WARN Certification 'not yet certified for current kernel/hardware'; fi; }
case "${1:-status}" in status) status;; record-suspend) record_suspend;; certify) certify;; *) echo 'Usage: final-certification [status|record-suspend|certify]' >&2; exit "$EXIT_USAGE";; esac
