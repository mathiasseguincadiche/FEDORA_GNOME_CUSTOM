#!/usr/bin/env bash
set -Eeuo pipefail
REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source "$REPO_ROOT/lib/bootstrap.sh"; engine_bootstrap
source "$REPO_ROOT/lib/validation_gates.sh"
quiet=false; interactive=false
screen_stream=false; camera_stream=false
for arg in "$@"; do case "$arg" in --quiet) quiet=true;; --interactive) interactive=true;; --gate3) :;; *) echo 'Usage: portal-functional-doctor [--quiet] [--interactive] [--gate3]' >&2; exit "$EXIT_USAGE";; esac; done
ok=0; ko=0
emit(){ $quiet || ui_check "$1" "$2" "$3"; case "$1" in OK)((ok+=1));; KO)((ko+=1));; esac; }
portal_call(){ gdbus call --session --dest org.freedesktop.portal.Desktop --object-path /org/freedesktop/portal/desktop --method "$@"; }
confirm(){ local label="$1" phrase="$2" answer; printf '%s\nTapez exactement %s : ' "$label" "$phrase"; read -r answer; [[ "$answer" == "$phrase" ]]; }

# Invalidate interactive evidence before session/service checks can fail.
# Read-only checks preserve existing evidence.
if $interactive; then
  rm -f "$(physical_runtime_evidence_path portal-functional)" "$STATE_ROOT/final/certified.ok"
  validation_require_installed_runtime || exit $?
fi

if [[ "${XDG_CURRENT_DESKTOP:-}" != *GNOME* || "${XDG_SESSION_TYPE:-}" != wayland ]]; then emit KO Session 'GNOME/Wayland required'; exit "$EXIT_PRECHECK_FAILED"; fi
if ! "$REPO_ROOT/diagnostics/portal-doctor" --quiet; then emit KO Portal 'base portal doctor failed'; exit "$EXIT_POSTCHECK_FAILED"; fi
interfaces="$(busctl --user introspect org.freedesktop.portal.Desktop /org/freedesktop/portal/desktop 2>/dev/null || true)"
for iface in FileChooser OpenURI Notification ScreenCast; do
  if grep -Fq "org.freedesktop.portal.$iface" <<<"$interfaces"; then emit OK "$iface" exposed; else emit KO "$iface" missing; fi
done

# CreateSession/SelectSources/Start and actual streams are tested by the interactive probe.

if $interactive; then
  if [[ ! -t 0 || ! -t 1 ]]; then emit KO Interactive 'TTY required'; exit "$EXIT_PRECHECK_FAILED"; fi
  nid="fgc-portal-${RANDOM}-$$"
  if portal_call org.freedesktop.portal.Notification.AddNotification "$nid" "{'title': <'Fedora GNOME Golden'>, 'body': <'Portal notification smoke test'>}" >/dev/null 2>&1; then
    if confirm 'Confirmez que la notification GNOME est apparue.' JE_CONFIRME_NOTIFICATION; then emit OK Notification 'visual smoke PASS'; else emit KO Notification 'visual confirmation refused'; fi
  else emit KO Notification 'portal AddNotification failed'; fi
  portal_call org.freedesktop.portal.Notification.RemoveNotification "$nid" >/dev/null 2>&1 || true

  if portal_call org.freedesktop.portal.OpenURI.OpenURI '' 'https://example.com/' "{'ask': <false>}" >/dev/null 2>&1; then
    if confirm 'Confirmez que la requête OpenURI a ouvert/proposé le navigateur attendu.' JE_CONFIRME_OPENURI; then emit OK OpenURI 'functional smoke PASS'; else emit KO OpenURI 'visual confirmation refused'; fi
  else emit KO OpenURI 'portal OpenURI failed'; fi

  if portal_call org.freedesktop.portal.FileChooser.OpenFile '' 'Fedora GNOME Golden — FileChooser smoke' "{'multiple': <false>}" >/dev/null 2>&1; then
    if confirm 'Le sélecteur de fichiers GNOME doit être visible; sélectionnez ou annulez puis confirmez.' JE_CONFIRME_FILECHOOSER; then emit OK FileChooser 'functional smoke PASS'; else emit KO FileChooser 'visual confirmation refused'; fi
  else emit KO FileChooser 'portal OpenFile failed'; fi

  # Select an actual display and authorize sharing; cancellation cannot certify.
  if python3 "$REPO_ROOT/scripts/validation/portal-stream-probe.py" screen &&
     confirm "Confirmez que le partage réel s'est effectué, puis arrêté normalement." JE_CONFIRME_SCREENCAST; then
    screen_stream=true; emit OK ScreenCast '10 actual PipeWire frames consumed; stream closed'
  else emit KO ScreenCast 'sharing cancelled, denied or unusable'; fi
  if python3 "$REPO_ROOT/scripts/validation/portal-stream-probe.py" camera; then
    camera_stream=true; emit OK Camera '10 actual portal-authorized camera frames consumed'
  else emit KO Camera 'camera permission/stream unusable'; fi
fi

if (( ko == 0 )) && $interactive && $screen_stream; then
  $camera_stream || exit "$EXIT_POSTCHECK_FAILED"
  physical_runtime_write_evidence portal-functional 'stream_policy=2 FileChooser=PASS OpenURI=PASS Notification=PASS ScreenCast=PASS Camera=PASS'
fi
$quiet || { ui_meta OK "$ok"; ui_meta KO "$ko"; }
(( ko == 0 ))
