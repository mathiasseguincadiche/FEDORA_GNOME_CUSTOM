#!/usr/bin/env bash
set -Eeuo pipefail
REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source "$REPO_ROOT/lib/bootstrap.sh"; engine_bootstrap
# shellcheck source=lib/backup_runtime.sh
source "$REPO_ROOT/lib/backup_runtime.sh"

policy_only=false
deep=false
for arg in "$@"; do
  case "$arg" in --policy-only) policy_only=true ;; --deep) deep=true ;; *) echo "Unknown argument: $arg" >&2; exit 2 ;; esac
done
ok=0; warn=0; ko=0
record() { local level="$1" label="$2" detail="$3"; printf '%-4s %-30s %s\n' "$level" "$label" "$detail"; case "$level" in OK) ((ok+=1));; WARN) ((warn+=1));; KO) ((ko+=1));; esac; }

[[ "${BACKUP_ENGINE:-}" == restic ]] && record OK engine restic || record KO engine "${BACKUP_ENGINE:-unset}"
is_true "${BACKUP_FAIL_CLOSED:-false}" && record OK fail-closed enabled || record KO fail-closed disabled
is_true "${BACKUP_REQUIRE_EXTERNAL_TARGET:-false}" && record OK external-target required || record KO external-target not-required
is_true "${BACKUP_ENCRYPTION_REQUIRED:-false}" && record OK encryption required || record KO encryption not-required
is_true "${BACKUP_INTEGRITY_CHECK_REQUIRED:-false}" && record OK integrity-check required || record KO integrity-check not-required
is_true "${BACKUP_RESTORE_TEST_REQUIRED:-false}" && record OK restore-test required || record KO restore-test not-required
! is_true "${BACKUP_ALLOW_LIVE_QCOW2_COPY:-false}" && record OK live-qcow2 forbidden || record KO live-qcow2 allowed
is_true "${BACKUP_VM_SHUTDOWN_REQUIRED:-false}" && record OK vm-shutdown required || record KO vm-shutdown not-required
for file in scripts/backup/backup-now.sh scripts/backup/restore.sh scripts/backup/disaster-recovery.sh prepare-preapply-backup.sh; do [[ -r "$REPO_ROOT/$file" ]] && record OK "$file" present || record KO "$file" missing; done
command -v restic >/dev/null 2>&1 && record OK restic installed || record WARN restic 'not installed yet'

if ! $policy_only; then
  marker="$STATE_ROOT/preapply-backup.ok"
  if [[ -s "$marker" ]]; then
    marker_commit="$(awk -F= '$1=="commit" {print $2; exit}' "$marker")"
    marker_snapshot="$(awk -F= '$1=="snapshot" {print $2; exit}' "$marker")"
    [[ "$marker_commit" == "$(repo_commit)" ]] && record OK preapply-commit "$marker_commit" || record WARN preapply-commit "${marker_commit:-missing}"
    [[ "$marker_snapshot" =~ ^[0-9a-fA-F]{64}$ ]] && record OK preapply-snapshot valid || record WARN preapply-snapshot missing-or-invalid
  else
    record WARN preapply-marker 'not created yet'
  fi

  if command -v restic >/dev/null 2>&1; then
    repo="$(backup_runtime_resolve_repository 2>/dev/null || true)"
    password_file="$(backup_runtime_require_password 2>/dev/null || true)"
    if [[ -n "$repo" && -n "$password_file" ]]; then
      backup_runtime_export_env "$repo" "$password_file"
      if restic snapshots --latest 1 >/dev/null 2>&1; then
        record OK repository reachable
        if $deep; then
          restic check --read-data-subset=1/20 >/dev/null && record OK deep-integrity PASS || record KO deep-integrity FAIL
        fi
      else
        record KO repository unreachable
      fi
    else
      record WARN repository 'runtime repository/password not resolved'
    fi
  fi
fi
printf '\nBackup doctor: OK=%d WARN=%d KO=%d\n' "$ok" "$warn" "$ko"
((ko == 0))
