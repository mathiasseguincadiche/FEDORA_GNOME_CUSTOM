#!/usr/bin/env bash
set -Eeuo pipefail
REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source "$REPO_ROOT/lib/bootstrap.sh"; engine_bootstrap
ui_banner 'FEDORA WORKSTATION HEALTH' 'READ-ONLY'
ok=0; warn=0; ko=0
emit() { ui_check "$1" "$2" "$3"; case "$1" in OK) ((ok+=1));; WARN) ((warn+=1));; KO) ((ko+=1));; esac; }

if grep -Eq '^VERSION_ID="?44"?$' /etc/os-release; then emit OK Fedora '44'; else emit KO Fedora 'Fedora 44 required'; fi
if baseline_certification_valid; then emit OK 'Hardware baseline' 'certified for current hardware/BIOS'; else emit KO 'Hardware baseline' 'run baseline-doctor; certification missing or invalid'; fi
if lscpu | grep -Fq "$EXPECTED_CPU"; then emit OK CPU "$EXPECTED_CPU"; else emit KO CPU 'unexpected CPU'; fi
mem_kib="$(awk '/MemTotal/ {print $2}' /proc/meminfo)"
if (( mem_kib >= 45*1024*1024 )); then emit OK Memory '48 GiB class detected'; else emit KO Memory 'less than expected'; fi

if "$REPO_ROOT/diagnostics/host-security-policy-doctor" --quiet; then emit OK 'HOST security policy' 'Secure Boot OFF / local disk encryption forbidden'; else emit KO 'HOST security policy' 'Secure Boot or local disk encryption violates Golden policy'; fi
if "$REPO_ROOT/diagnostics/firmware-doctor" --quiet; then emit OK Firmware 'AMD microcode + Intel GPU firmware'; else emit KO Firmware 'run firmware-doctor'; fi
if "$REPO_ROOT/diagnostics/hardware-components-doctor" --quiet; then emit OK 'Board components' '5G LAN/Wi-Fi/BT/audio/xHCI'; else emit KO 'Board components' 'run hardware-components-doctor'; fi
if "$REPO_ROOT/diagnostics/graphics-doctor" --quiet; then emit OK Graphics 'Arc B580/xe baseline'; else emit KO Graphics 'run graphics-doctor'; fi
if "$REPO_ROOT/diagnostics/arc-compute-doctor" --quiet; then emit OK 'Arc compute' 'Level Zero/OpenCL'; else emit KO 'Arc compute' 'run arc-compute-doctor'; fi
if "$REPO_ROOT/diagnostics/storage-doctor" --quiet; then emit OK Storage 'T705 inventory baseline'; else emit KO Storage 'run storage-doctor'; fi

if [[ "$(getenforce 2>/dev/null || echo unknown)" == Enforcing ]]; then emit OK SELinux Enforcing; else emit KO SELinux 'not Enforcing'; fi
if systemctl is-active --quiet firewalld; then emit OK firewalld active; else emit WARN firewalld inactive; fi
if [[ "${XDG_CURRENT_DESKTOP:-}" == *GNOME* ]]; then if [[ "${XDG_SESSION_TYPE:-}" == wayland ]]; then emit OK GNOME 'Wayland session'; else emit WARN GNOME "session=${XDG_SESSION_TYPE:-unknown}"; fi; fi

if bash "$REPO_ROOT/diagnostics/gnome-doctor" --quiet; then emit OK 'GNOME integration' 'dock/AppIndicator/portal base'; else emit KO 'GNOME integration' 'run gnome-doctor'; fi
if "$REPO_ROOT/diagnostics/nautilus-integration-doctor" --quiet; then emit OK Nautilus 'GVfs/Sushi/archive/mobile/cloud integration'; else emit KO Nautilus 'run nautilus-integration-doctor'; fi
if "$REPO_ROOT/diagnostics/desktop-integration-doctor" --quiet; then emit OK Desktop 'secrets/print/VPN/power/language/remote'; else emit KO Desktop 'run desktop-integration-doctor'; fi
if "$REPO_ROOT/diagnostics/portal-doctor" --quiet; then emit OK Portals 'ScreenCast/FileChooser/OpenURI/Notification'; else emit KO Portals 'run portal-doctor'; fi
if "$REPO_ROOT/diagnostics/lifecycle-doctor" --quiet; then emit OK Lifecycle 'safe update timers'; else emit KO Lifecycle 'run lifecycle-doctor'; fi
if "$REPO_ROOT/diagnostics/shell-doctor" --quiet; then emit OK 'Bash UX' 'prompt/history/completion/navigation'; else emit KO 'Bash UX' 'run shell-doctor'; fi
if "$REPO_ROOT/diagnostics/ptyxis-doctor" --quiet; then emit OK Ptyxis 'native GNOME terminal + Bash contract'; else emit KO Ptyxis 'run ptyxis-doctor'; fi
if "$REPO_ROOT/diagnostics/daily-backup-doctor" --quiet; then emit OK 'Daily backup' 'timer healthy'; else emit KO 'Daily backup' 'run daily-backup-doctor'; fi

if bash "$REPO_ROOT/diagnostics/applications-doctor" --quiet; then emit OK Applications 'GTK4/libadwaita catalog + Ptyxis'; else emit KO Applications 'run applications-doctor'; fi
if "$REPO_ROOT/diagnostics/appimage-doctor" --quiet; then emit OK AppImage 'Type 1 + Type 2, FUSE2/FUSE3 multilib, Gear Lever'; else emit KO AppImage 'run appimage-doctor'; fi
if bash "$REPO_ROOT/diagnostics/media-doctor" --quiet; then emit OK Multimedia 'FFmpeg/GStreamer providers installed'; else emit KO Multimedia 'run media-doctor'; fi
if is_true "${GAMING_ENABLE:-false}"; then
  if "$REPO_ROOT/diagnostics/gaming-doctor" --quiet; then emit OK Gaming 'Steam/Proton/Vulkan multilib + gaming tools'; else emit KO Gaming 'run gaming-doctor'; fi
else
  emit OK Gaming 'optional profile disabled'
fi
if "$REPO_ROOT/diagnostics/software-matrix-doctor" --quiet; then emit OK 'Known-good matrix' certified; else emit WARN 'Known-good matrix' 'not certified or software versions changed'; fi

if is_true "${ENABLE_KVM:-true}"; then
  if bash "$REPO_ROOT/diagnostics/virtualization-doctor" --quiet; then emit OK Virtualization 'KVM/libvirt contract'; else emit KO Virtualization 'run virtualization-doctor'; fi
  if "$REPO_ROOT/diagnostics/kvm-io-doctor" --quiet; then emit OK 'KVM I/O profile' benchmarked; else emit WARN 'KVM I/O profile' 'run kvm-io-doctor benchmark'; fi
fi

previous="$(journalctl -k -b -1 --no-pager 2>/dev/null | grep -Eic 'kernel panic|Oops:|watchdog.*hard LOCKUP|xe.*(reset|hang|wedged)|PCIe Bus Error|nvme.*(I/O|reset)' || true)"
if (( previous == 0 )); then emit OK 'Previous boot' 'no critical signature matched'; else emit WARN 'Previous boot' "$previous critical signatures — run collect-boot-failure.sh"; fi
ui_meta OK "$ok"; ui_meta WARN "$warn"; ui_meta KO "$ko"
if (( ko == 0 )); then ui_summary 'WORKSTATION HEALTHY' 'DRY-RUN OR NORMAL USE' "$REPORT_ROOT" "$LOG_DIR"; else ui_summary 'WORKSTATION NEEDS ATTENTION' 'FIX KO BEFORE APPLY' "$REPORT_ROOT" "$LOG_DIR"; exit 20; fi
