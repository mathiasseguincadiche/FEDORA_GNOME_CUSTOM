#!/usr/bin/env bash
set -Eeuo pipefail
REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source "$REPO_ROOT/lib/bootstrap.sh"; engine_bootstrap
usage(){ cat <<'TXT'
Usage:
  baseline-doctor status|snapshot|certify|enroll-wifi
  baseline-doctor run-memory-test <5600|6000>
  baseline-doctor run-nvme-test <root|data>
TXT
}
require_baremetal(){ runtime_is_baremetal || { ui_error "Hardware evidence is bare-metal only; runtime=$(runtime_environment)"; exit "$EXIT_SECURITY_BLOCK"; }; }
prepare_platform(){
  require_baremetal
  command_exists modprobe || { ui_error 'modprobe is required for NCT6687D hwmon validation'; exit "$EXIT_PRECHECK_FAILED"; }
  if ! lsmod | grep -q '^nct6683'; then
    sudo modprobe nct6683 || { ui_error 'Unable to load Fedora in-tree nct6683 driver for the NCT6687D-R; force=1 and third-party modules are forbidden.'; exit "$EXIT_PRECHECK_FAILED"; }
  fi
}
snapshot(){ local report="$REPORT_ROOT/$RUN_ID-hardware-baseline-snapshot.txt"; { echo '[runtime]'; runtime_environment; echo '[fingerprint]'; baseline_fingerprint_payload; echo '[platform]'; printf 'board_vendor=%s\nboard_name=%s\nbios_vendor=%s\nbios_version=%s\nbios_date=%s\n' "$(hardware_platform_board_vendor)" "$(hardware_platform_board_name)" "$(hardware_platform_bios_vendor)" "$(hardware_platform_bios_version)" "$(hardware_platform_bios_date)"; printf 'cpu_scaling_driver=%s\namd_pstate=%s\nboost=%s\n' "$(hardware_platform_cpu_scaling_driver 2>/dev/null || echo unknown)" "$(hardware_platform_cpu_pstate_status 2>/dev/null || echo unknown)" "$(hardware_platform_cpu_boost_value 2>/dev/null || echo unknown)"; hardware_platform_wifi_identity 2>/dev/null || true; hardware_platform_hwmon_counts 2>/dev/null || true; echo '[os]'; cat /etc/os-release; echo '[kernel]'; uname -a; echo '[sleep]'; cat /sys/power/mem_sleep 2>/dev/null || true; echo '[kernel-signatures]'; journalctl -k -b --no-pager 2>/dev/null | grep -Ei 'MCE|EDAC|xe|drm|PCIe|AER|nvme|watchdog|panic|Oops|thermal|nct668' || true; } > "$report"; printf '%s\n' "$report"; }
run_memory(){ require_baremetal; local speed="$1" actual log sha; [[ "$speed" == 5600 || "$speed" == 6000 ]] || { usage; exit "$EXIT_USAGE"; }; command_exists stress-ng || sudo dnf -y install stress-ng; actual="$(sudo dmidecode --type 17 2>/dev/null | awk -F: '/Configured Memory Speed:/ {gsub(/^[ \t]+/,"",$2); print $2}' | sort -u | paste -sd, -)"; grep -Eq "(^|[^0-9])${speed}[[:space:]]*MT/s" <<<"$actual" || { ui_error "Configured memory speed does not report ${speed} MT/s: $actual"; exit "$EXIT_PRECHECK_FAILED"; }; log="$REPORT_ROOT/$RUN_ID-memory-${speed}.log"; stress-ng --vm 2 --vm-bytes 70% --verify --timeout "${BASELINE_MEMORY_TEST_SECONDS:-3600}s" --metrics-brief >"$log" 2>&1; sha="$(sha256sum "$log" | awk '{print $1}')"; baseline_write_evidence "memory-$speed" PASS "automated=true tool=stress-ng speed=${speed} sha256=$sha log=$log"; ui_check OK "memory-$speed" "automated stress-ng PASS sha256=$sha"; }
mount_source_device(){ local src; src="$(findmnt -no SOURCE "$1" | sed -E 's/\[.*$//')"; lsblk -ndo NAME,TYPE -s "$src" 2>/dev/null | awk '$2=="disk" {print "/dev/"$1; exit}'; }
run_nvme(){ require_baremetal; local target="$1" mount file log sha dev; case "$target" in root) mount=/;; data) mount="${EXPECTED_DATA_MOUNT:-/data}";; *) usage; exit "$EXIT_USAGE";; esac; [[ -d "$mount" && -w "$mount" ]] || { ui_error "$mount is not a writable mounted filesystem"; exit "$EXIT_PRECHECK_FAILED"; }; command_exists fio || sudo dnf -y install fio; dev="$(mount_source_device "$mount")"; [[ "$dev" == /dev/nvme* ]] || { ui_error "$mount is not backed by a physical NVMe device: $dev"; exit "$EXIT_PRECHECK_FAILED"; }; file="$mount/.fgc-nvme-certification.bin"; log="$REPORT_ROOT/$RUN_ID-nvme-$target.log"; trap 'rm -f "$file"' EXIT; fio --name="fgc-$target" --filename="$file" --size=4G --rw=write --bs=1M --direct=1 --iodepth=32 --verify=crc32c --verify_fatal=1 --do_verify=1 --group_reporting >"$log" 2>&1; rm -f "$file"; trap - EXIT; sha="$(sha256sum "$log" | awk '{print $1}')"; baseline_write_evidence "nvme-$target" PASS "automated=true tool=fio device=$dev sha256=$sha log=$log"; ui_check OK "nvme-$target" "automated fio PASS sha256=$sha"; }
case "${1:-status}" in
 status)
   ui_banner 'HARDWARE BASELINE' 'PRE-APPLY CERTIFICATION'
   ui_meta Fingerprint "$(baseline_fingerprint)"
   if baseline_certification_valid; then ui_check OK Certification valid; else ui_check KO Certification missing; fi
   for item in memory-5600 memory-6000 nvme-root nvme-data; do
     if baseline_evidence_valid "$item"; then ui_check OK "$item" PASS; else ui_check WARN "$item" missing; fi
   done
   if hardware_platform_wifi_lock_valid; then ui_check OK 'Wi-Fi identity lock' "$(hardware_platform_wifi_lock_path)"; else ui_check WARN 'Wi-Fi identity lock' 'run baseline-doctor enroll-wifi on bare metal'; fi
   ui_check INFO Suspend 'certified after APPLY/reboot by final-certification'
   ;;
 snapshot) require_baremetal; ui_meta Report "$(snapshot)" ;;
 enroll-wifi)
   prepare_platform
   hardware_platform_validate_dmi || { ui_error 'Motherboard DMI/BIOS identity is not the expected MSI platform'; exit "$EXIT_PRECHECK_FAILED"; }
   path="$(hardware_platform_enroll_wifi_identity)" || { ui_error 'Unable to enroll the physical Wi-Fi PCI identity/driver'; exit "$EXIT_PRECHECK_FAILED"; }
   ui_check OK 'Wi-Fi identity enrolled' "$path"
   ui_meta PCI "$(hardware_platform_wifi_identity_value pci_id)"
   ui_meta Driver "$(hardware_platform_wifi_identity_value driver)"
   ;;
 run-memory-test) run_memory "${2:-}" ;;
 run-nvme-test) run_nvme "${2:-}" ;;
 certify)
   prepare_platform
   if baseline_certify; then
     ui_check OK Certification "$(baseline_certification_path)"
   else
     ui_error 'Certification refused: RAM/NVMe evidence, DMI/BIOS, AMD P-State/boost, Wi-Fi identity lock, NCT6687D hwmon, GPU or storage health is incomplete.'
     exit "$EXIT_PRECHECK_FAILED"
   fi
   ;;
 *) usage; exit "$EXIT_USAGE" ;;
esac
