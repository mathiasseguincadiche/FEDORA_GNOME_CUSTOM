#!/usr/bin/env bash
set -Eeuo pipefail
REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source "$REPO_ROOT/lib/bootstrap.sh"; engine_bootstrap
source "$REPO_ROOT/lib/kernel_lifecycle.sh"
quiet=false; [[ "${1:-}" == '--quiet' ]] && quiet=true
ok=0; warn=0; ko=0
emit(){ if ! $quiet; then ui_check "$1" "$2" "$3"; fi; case "$1" in OK)((ok+=1));; WARN)((warn+=1));; KO)((ko+=1));; esac; }
current="$(uname -r)"; base="${current%%-*}"
if printf '%s\n%s\n' "${KERNEL_MIN_VERSION:-7.2.2}" "$base" | sort -V -C; then emit OK Kernel "$current >= ${KERNEL_MIN_VERSION:-7.2.2}"; else emit KO Kernel "$current < ${KERNEL_MIN_VERSION:-7.2.2}"; fi
candidate="$(kernel_lifecycle_candidate_release)"
certified="$(kernel_lifecycle_certified_release)"
previous="$(kernel_lifecycle_previous_release)"
if [[ -n "$candidate" && "$current" == "$candidate" ]]; then
  emit OK 'Kernel lifecycle' "running candidate $candidate in qualification mode"
elif [[ -n "$certified" && "$current" == "$certified" ]]; then
  emit OK 'Kernel lifecycle' "running certified Golden $certified"
elif [[ -n "$certified" ]]; then
  emit WARN 'Kernel lifecycle' "running=$current certified=$certified candidate=${candidate:-none}"
else
  emit WARN 'Kernel lifecycle' "no certified Golden kernel yet; running=$current candidate=${candidate:-none}"
fi
if [[ -n "$candidate" ]]; then
  if kernel_lifecycle_release_installed "$candidate" && kernel_lifecycle_release_is_stable "$candidate" && [[ "$candidate" == *vanilla* ]]; then emit OK Candidate "$candidate staged"; else emit KO Candidate "$candidate invalid or not installed"; fi
fi
if [[ -n "$certified" ]]; then
  if kernel_lifecycle_release_installed "$certified"; then emit OK Certified "$certified installed"; else emit KO Certified "$certified marker exists but package is missing"; fi
fi
if [[ -n "$previous" ]]; then
  if kernel_lifecycle_release_installed "$previous"; then emit OK 'Previous certified' "$previous retained"; else emit WARN 'Previous certified' "$previous marker exists but package is missing"; fi
fi
available="$(kernel_lifecycle_latest_available 2>/dev/null || true)"
if [[ -n "$available" ]]; then
  if [[ -n "$candidate" && "$available" == "$candidate" ]]; then emit OK 'Latest stable' "$available is staged candidate"; elif [[ -n "$certified" && "$available" == "$certified" ]]; then emit OK 'Latest stable' "$available is already certified"; else emit WARN 'Latest stable' "available=$available certified=${certified:-none} candidate=${candidate:-none}; newer does not auto-promote"; fi
else
  emit WARN 'Latest stable' 'unresolved from enabled repositories'
fi
if lspci -nnk -d 8086:e20b 2>/dev/null | grep -Fq 'Kernel driver in use: xe'; then emit OK 'Arc B580' 'xe bound'; else emit KO 'Arc B580' 'xe not bound'; fi
if mokutil --sb-state 2>/dev/null | grep -Eqi 'SecureBoot enabled|Secure Boot enabled'; then emit WARN 'Secure Boot' 'enabled; Kernel Vanilla requires explicit trust/signing'; else emit OK 'Secure Boot' 'not blocking vanilla kernel'; fi
if rpm -qa 'kernel-core-*.fc44*' 2>/dev/null | grep -q .; then emit OK Fallback 'Fedora kernel remains installed'; else emit WARN Fallback 'no Fedora fc44 kernel-core package detected'; fi
if journalctl -k -b --no-pager 2>/dev/null | grep -Eqi '\bxe\b.*(wedged|reset failed|gpu hang)|kernel panic|Oops:'; then emit KO Journal 'critical kernel/xe signature found'; else emit OK Journal 'no critical kernel/xe signature'; fi
if ! $quiet; then ui_meta OK "$ok"; ui_meta WARN "$warn"; ui_meta KO "$ko"; fi
(( ko == 0 ))
