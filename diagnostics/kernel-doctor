#!/usr/bin/env bash
set -Eeuo pipefail
REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source "$REPO_ROOT/lib/bootstrap.sh"; engine_bootstrap
ok=0; warn=0; ko=0
record() { local s="$1" n="$2" d="$3"; ui_check "$s" "$n" "$d"; case "$s" in OK) ((ok+=1));; WARN) ((warn+=1));; KO) ((ko+=1));; esac; }
release="$(uname -r)"; cmdline="$(< /proc/cmdline)"; taint="$(< /proc/sys/kernel/tainted)"
if [[ "$release" == *"${KERNEL_EXPECT_RELEASE_TOKEN:-fc44}"* ]]; then record OK kernel "$release"; else record KO kernel "$release"; fi
if grep -Eqi -- "${KERNEL_FORBIDDEN_CMDLINE_REGEX:-$^}" <<< "$cmdline"; then record KO cmdline 'forbidden stability workaround detected'; else record OK cmdline 'no forbidden global workaround'; fi
if [[ "$taint" == 0 ]]; then record OK taint clean; else record KO taint "$taint"; fi
if [[ -r /sys/devices/system/cpu/amd_pstate/status ]]; then record OK amd-pstate "$(< /sys/devices/system/cpu/amd_pstate/status)"; else record WARN amd-pstate 'status not exposed'; fi
microcode="$(awk '/^microcode[[:space:]]*:/ {print $3; exit}' /proc/cpuinfo 2>/dev/null || true)"
if [[ -n "$microcode" ]]; then record OK microcode "$microcode"; else record WARN microcode unavailable; fi
if [[ -d /sys/fs/pstore ]]; then record OK pstore available; else record WARN pstore unavailable; fi
if command -v kdumpctl >/dev/null 2>&1; then
  if kdumpctl status >/dev/null 2>&1; then record OK kdump ready; else record WARN kdump 'installed but not armed'; fi
else
  record WARN kdump 'not installed'
fi
ui_meta OK "$ok"; ui_meta WARN "$warn"; ui_meta KO "$ko"; (( ko == 0 ))
