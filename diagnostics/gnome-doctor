#!/usr/bin/env bash
set -Eeuo pipefail
REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source "$REPO_ROOT/lib/bootstrap.sh"; engine_bootstrap
quiet=false; [[ "${1:-}" == '--quiet' ]] && quiet=true
ko=0

report_extension() {
  local label="$1" pkg="$2" uuid="$3"
  if rpm -q "$pkg" >/dev/null 2>&1; then
    if ! $quiet; then ui_check OK "$label" 'Fedora RPM installed'; fi
  else
    if ! $quiet; then ui_check KO "$label" 'Fedora RPM missing'; fi
    ((ko+=1))
    return
  fi

  if command_exists gnome-extensions && gnome-extensions list 2>/dev/null | grep -Fxq "$uuid"; then
    if gnome-extensions info "$uuid" 2>/dev/null | grep -Fq 'State: ENABLED'; then
      if ! $quiet; then ui_check OK "$label" 'enabled in GNOME Shell'; fi
    else
      if ! $quiet; then ui_check KO "$label" 'installed but not enabled'; fi
      ((ko+=1))
    fi
  elif [[ "${XDG_CURRENT_DESKTOP:-}" == *GNOME* ]]; then
    if ! $quiet; then ui_check KO "$label" 'extension not visible to current GNOME session'; fi
    ((ko+=1))
  fi
}

for pkg in gnome-shell nautilus gvfs-smb xdg-desktop-portal-gnome; do
  if rpm -q "$pkg" >/dev/null 2>&1; then
    if ! $quiet; then ui_check OK "$pkg" installed; fi
  else
    if ! $quiet; then ui_check KO "$pkg" missing; fi
    ((ko+=1))
  fi
done

if is_true "${ENABLE_DASH_TO_DOCK:-false}"; then
  report_extension 'Dash to Dock' "${DASH_TO_DOCK_PACKAGE:-gnome-shell-extension-dash-to-dock}" "${DASH_TO_DOCK_UUID:-dash-to-dock@micxgx.gmail.com}"
fi

if is_true "${ENABLE_BLUR_MY_SHELL:-false}"; then
  report_extension 'Blur My Shell' "${BLUR_MY_SHELL_PACKAGE:-gnome-shell-extension-blur-my-shell}" "${BLUR_MY_SHELL_UUID:-blur-my-shell@aunetx}"
fi

if is_true "${INSTALL_EXTENSION_MANAGER:-false}"; then
  if flatpak info "${EXTENSION_MANAGER_FLATPAK_ID:-com.mattjakeman.ExtensionManager}" >/dev/null 2>&1; then
    if ! $quiet; then ui_check OK 'Extension Manager' 'Flathub app installed'; fi
  else
    if ! $quiet; then ui_check KO 'Extension Manager' 'Flatpak missing'; fi
    ((ko+=1))
  fi
fi

if is_true "${ENABLE_JUST_PERFECTION:-false}"; then
  if ! $quiet; then ui_check KO 'Just Perfection' 'forbidden by desktop policy'; fi
  ((ko+=1))
fi

if [[ "${XDG_CURRENT_DESKTOP:-}" == *GNOME* ]]; then
  if [[ "${XDG_SESSION_TYPE:-}" == wayland ]]; then
    if ! $quiet; then ui_check OK Wayland active; fi
  else
    if ! $quiet; then ui_check WARN Wayland "${XDG_SESSION_TYPE:-unknown}"; fi
  fi
  if systemctl --user is-active --quiet xdg-desktop-portal.service; then
    if ! $quiet; then ui_check OK Portal active; fi
  else
    if ! $quiet; then ui_check WARN Portal inactive; fi
  fi
fi
(( ko == 0 ))
